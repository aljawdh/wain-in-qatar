{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "data/*.json"
    }
  },
  "crons": [
    { "path": "/api/run-snapshots", "schedule": "0 0 * * *" },
    {
      "path": "/api/run-intelligence-memory-cron",
      "schedule": "0 * * * *"
    }
  ],
  "redirects": [
    { "source": "/", "destination": "/public/index.html", "permanent": false },
    { "source": "/admin", "destination": "/admin.html", "permanent": false },
    { "source": "/admin/monitoring", "destination": "/admin/monitoring/index.html", "permanent": false },
    { "source": "/admin/intelligence", "destination": "/admin/intelligence/index.html", "permanent": false },
    { "source": "/admin/intelligence/cron", "destination": "/admin/intelligence/cron.html", "permanent": false },
    { "source": "/field", "destination": "/field/index.html", "permanent": false }
  ],
  "rewrites": [
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/index.html", "destination": "/public/index.html" },
    { "source": "/css/:path*", "destination": "/public/css/:path*" },
    { "source": "/js/:path*", "destination": "/public/js/:path*" },
    { "source": "/favicon.png", "destination": "/public/favicon.png" },
    { "source": "/api/admin/summary", "destination": "/api?route=admin-summary" },
    { "source": "/api/admin/:path*", "destination": "/api?route=admin&path=:path*" },
    { "source": "/api/navidur-analysis", "destination": "/api?route=analysis" },
    { "source": "/api/admin-settings", "destination": "/api?route=admin-settings" },
    { "source": "/api/admin-analytics", "destination": "/api?route=admin-analytics" },
    { "source": "/api/run-intelligence-memory-cron", "destination": "/api?route=run-intelligence-memory-cron" },
    { "source": "/api/fish-species", "destination": "/api?route=fish-species" },
    { "source": "/api/compute-decision", "destination": "/api?route=compute-decision" },
    { "source": "/api/log-catch", "destination": "/api?route=log-catch" },
    { "source": "/api/catch-data", "destination": "/api?route=catch-data" },
    { "source": "/api/system-storage-health", "destination": "/api?route=system-storage-health" },
    { "source": "/api/fishing-engine", "destination": "/api?route=fishing-engine" },
    { "source": "/api/stations", "destination": "/api?route=stations" },
    { "source": "/api/tracking", "destination": "/api?route=tracking" },
    { "source": "/api/feedback", "destination": "/api?route=feedback" },
    { "source": "/api/login", "destination": "/api?route=login" },
    { "source": "/api/logout", "destination": "/api?route=logout" },
    { "source": "/api/vercel-analytics", "destination": "/api?route=vercel-analytics" },
    { "source": "/api/runtime-store", "destination": "/api?route=runtime-store" },
    { "source": "/api/_store", "destination": "/api?route=store" },
    { "source": "/api/:path*", "destination": "/api?route=:path*" },
    { "source": "/admin.html", "destination": "/admin.html" },
    { "source": "/:path*", "destination": "/:path*" }
  ]
}
