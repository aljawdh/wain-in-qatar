    class NavidurStation {
      constructor(index, base) {
        this.index = index;
        this.id = 'st_' + String(index + 1).padStart(3, '0');
        this.name = base.name;
        this.country = base.country;
        this.region = base.region || '';
        this.lat = base.lat;
        this.lng = base.lng;
        this.flag = base.flag;
        this.defaultRadius = Number(base.default_radius || 0.02);
        this.timezone = COUNTRY_TIMEZONES[base.country] || 'Asia/Qatar';
        this.utcOffset = COUNTRY_UTC_OFFSET_HOURS[base.country] || 3;
        const mappedBathymetry = STATION_BATHYMETRY[base.name] || null;
        const resolvedMode = String(base.fishing_mode || '').toLowerCase() === 'deep' ? 'deep' : (String(base.fishing_mode || '').toLowerCase() === 'coastal' ? 'coastal' : (mappedBathymetry === 'deep' ? 'deep' : 'coastal'));
        this.fishing_mode = resolvedMode;
        this.fishingMode = resolvedMode;
        this.bathymetry = mappedBathymetry || (resolvedMode === 'deep' ? 'deep' : 'shallow');
        this.tideSource = 'tide://' + encodeURIComponent(base.country) + '/' + encodeURIComponent(base.name);
        this.sohail = SOHAIL_STATIONS[base.name] || SOHAIL_STATIONS['الدوحة'];
        this.speciesPriority = STATION_SPECIES_PRIORITY[base.name] || [];
        const marinePoint = STATION_MARINE_GRID[base.name] || null;
        this.marineLat = marinePoint ? marinePoint.lat : base.lat;
        this.marineLng = marinePoint ? marinePoint.lng : base.lng;
      }

      getMarineRegion() {
        if (ARABIAN_SEA_STATIONS.some(s => this.name.includes(s))) return 'arabian_sea';
        if (RED_SEA_STATIONS.some(s => this.name.includes(s))) return 'red_sea';
        if (OMAN_SEA_STATIONS.some(s => this.name.includes(s))) return 'oman_sea';
        return 'gulf';
      }

      getBathymetryLabel() {
        if (this.bathymetry === 'shallow') return 'ساحلي';
        if (this.bathymetry === 'deep') return 'غزير';
        return 'متوسط';
      }

      getSohailRisingUtc(year) {
        const offsetMs = this.utcOffset * 3600000;
        return new Date(Date.UTC(year, this.sohail.month - 1, this.sohail.day, 0, 0, 0) - offsetMs);
      }
    }

