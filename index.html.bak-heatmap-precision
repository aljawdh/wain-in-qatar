    function getWhyBreakdown(result) {
      const data = result && result.data ? result.data : {};
      const current = data.current != null ? data.current : 0;
      const wave = data.wave != null ? data.wave : 0;
      const selectedHour = getSelectedHourEntry().hour || {};
      const wind = getDisplayedWindKmh(selectedHour) || 0;

      const currentPts = current >= 0.6 ? 30 : (current >= 0.45 ? 25 : 8);
      const windPts = wind <= 20 ? 20 : (wind <= 30 ? 12 : 6);
      const activityPts = wave >= 0.3 && wave <= 1.2 ? 20 : 8;
      return {
        currentPts,
        windPts,
        activityPts,
        wind,
        wave,
        current
      };
    }

    function getSessionId() {
      const key = 'navidur_session_id';
      let v = localStorage.getItem(key);
      if (!v) {
        v = 'sess_' + Date.now().toString(36) + Math.random().toString(36).slice(2, 10);
        localStorage.setItem(key, v);
      }
      return v;
    }

    function getFunnelSession() {
      const key = 'navidur_tracking_session';
      try {
        const raw = localStorage.getItem(key);
        if (raw) return JSON.parse(raw);
      } catch (_) { /* ignore */ }
      return { country_selected: false, mode_selected: false, station_selected: false, analysis_completed: false };
    }

    function saveFunnelSession(s) {
      localStorage.setItem('navidur_tracking_session', JSON.stringify(s));
    }

    function resetFunnelSession() {
      saveFunnelSession({ country_selected: false, mode_selected: false, station_selected: false, analysis_completed: false });
    }

    const REQUIRED_FIELDS = {
      country_select:    ['event_type', 'country'],
      mode_select:       ['event_type', 'country', 'fishing_mode'],
      station_select:    ['event_type', 'country', 'fishing_mode', 'station_id', 'station'],
      analysis_complete: ['event_type', 'country', 'fishing_mode', 'station_id', 'station']
    };

    function trackOnce(eventType, record) {
      const s = getFunnelSession();
      const flagMap = { country_select: 'country_selected', mode_select: 'mode_selected', station_select: 'station_selected', analysis_complete: 'analysis_completed' };
      const flag = flagMap[eventType];
      if (!flag || s[flag]) return; // already sent this session
      // Validate required fields — drop incomplete events
      const required = REQUIRED_FIELDS[eventType] || [];
      for (const f of required) {
        if (!record[f]) return; // missing required field — silently drop
      }
      s[flag] = true;
      saveFunnelSession(s);
      pushTrackingRecord(record);
      flushTrackingQueue();
    }

    function pushTrackingRecord(record) {
      const key = 'navidur_tracking_queue';
      const current = JSON.parse(localStorage.getItem(key) || '[]');
      current.push(record);
      localStorage.setItem(key, JSON.stringify(current.slice(-500)));
    }

    async function flushTrackingQueue() {
      const key = 'navidur_tracking_queue';
      const list = JSON.parse(localStorage.getItem(key) || '[]');
      if (!Array.isArray(list) || !list.length) return;
      try {
        const res = await fetch('/api?route=tracking', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ records: list.slice(0, 100) })
        });
        if (res.ok) {
          localStorage.setItem(key, JSON.stringify(list.slice(100)));
        }
      } catch (_err) {
        // Keep queued tracking until next flush.
      }
    }

    async function sendFeedbackVote(answer) {
      if (!latestHotspotResult || !latestHotspotResult.best_spot) return;
      const feedbackStatus = document.getElementById('feedbackStatus');
      if (!feedbackStatus) return;
      if (!isLoggedInMember()) {
        updateMemberAuthUi('feedback متاح فقط لعضو اختبار مسجل.', true);
        return;
      }
      const best = latestHotspotResult.best_spot;
      const payload = {
        answer,
        station: selectedStation ? selectedStation.name : null,
        lat: best.lat,
        lon: best.lon,
        score: best.score,
        zone: best.zone || null,
        timestamp: new Date().toISOString(),
        session_id: getSessionId()
      };

      feedbackStatus.textContent = 'Sending...';
      try {
        const response = await fetch('/api?route=feedback', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': 'Bearer ' + memberAuthState.token
          },
          body: JSON.stringify(payload)
        });
        if (!response.ok) {
          throw new Error('feedback_http_' + response.status);
        }
        feedbackStatus.textContent = 'Thanks, feedback saved.';
      } catch (_err) {
        feedbackStatus.textContent = 'Feedback failed. Try again.';
      }
    }

    /**
     * Client-only densification for map/heatmap/hotspot display.
     * Scores are IDW from engine `evaluated_points` (no extra API calls, no DTO change).
     */
    function interpolateScoreZoneFromEvaluated(lat, lon, sourcePoints) {
      const list = Array.isArray(sourcePoints) ? sourcePoints : [];
      if (!list.length) return { score: 0, zone: '' };
      const eps = 1e-10;
      let wsum = 0;
      let ssum = 0;
      let bestIdx = 0;
      let bestD = Infinity;
      for (let i = 0; i < list.length; i++) {
        const p = list[i];
        const plat = Number(p.lat);
        const plon = Number(p.lon);
        const dLat = lat - plat;
        const dLon = lon - plon;
        const d = Math.sqrt(dLat * dLat + dLon * dLon) + eps;
        if (d < bestD) {
          bestD = d;
          bestIdx = i;
        }
        const w = 1 / (d * d);
        wsum += w;
        ssum += w * navidurPointScoreForHeat(p);
      }
      const rawAvg = wsum > 0 ? ssum / wsum : 0;
      const score = Math.round(Math.max(0, Math.min(100, rawAvg)));
      const zone = list[bestIdx] && list[bestIdx].zone != null ? list[bestIdx].zone : '';
      return { score: score, zone: zone };
    }

    function navidurDisplayGridFindBestIdx(displayPoints, bestSpot) {
      if (!bestSpot || !Array.isArray(displayPoints) || !displayPoints.length) return -1;
      const bl = Number(bestSpot.lat);
      const bo = Number(bestSpot.lon);
      if (!isFinite(bl) || !isFinite(bo)) return -1;
      let bestIdx = -1;
      let bestD = Infinity;
      for (let i = 0; i < displayPoints.length; i++) {
        const p = displayPoints[i];
        const d = haversineKm(Number(p.lat), Number(p.lon), bl, bo);
        if (d < bestD) {
          bestD = d;
          bestIdx = i;
        }
      }
      return bestIdx;
    }

    function navidurCollectWaterFieldsUsed(sourcePoints) {
      const fields = [];
      const seen = {};
      (Array.isArray(sourcePoints) ? sourcePoints : []).forEach(function (p) {
        if (!p || typeof p !== 'object') return;
        ['water_status', 'is_water', 'is_land', 'waterStatus'].forEach(function (k) {
          if (p[k] != null && !seen[k]) {
            seen[k] = true;
            fields.push(k);
          }
        });
      });
      return fields;
    }

    function navidurAttachWaterMetaFromNearestSource(gridPoint, sourcePoints) {
      const list = Array.isArray(sourcePoints) ? sourcePoints : [];
      if (!list.length || !gridPoint) return;
      let bestD = Infinity;
      let best = null;
      for (let i = 0; i < list.length; i++) {
        const p = list[i];
        const plat = Number(p.lat);
        const plon = Number(p.lon);
        if (!isFinite(plat) || !isFinite(plon)) continue;
        const dLat = Number(gridPoint.lat) - plat;
        const dLon = Number(gridPoint.lon) - plon;
        const d = dLat * dLat + dLon * dLon;
        if (d < bestD) {
          bestD = d;
          best = p;
        }
      }
      if (!best) return;
      if (best.water_status != null) gridPoint.water_status = best.water_status;
      if (best.waterStatus != null && gridPoint.water_status == null) gridPoint.water_status = best.waterStatus;
      if (best.is_water != null) gridPoint.is_water = best.is_water;
      if (best.is_land != null) gridPoint.is_land = best.is_land;
    }

    /** @returns {'water'|'land'|'unknown'} */
    function navidurClassifyPointWaterKind(p) {
      if (!p) return 'unknown';
      const wsRaw = p.water_status != null ? p.water_status : p.waterStatus;
      const ws = wsRaw != null ? String(wsRaw).trim().toLowerCase() : '';
      if (ws === 'confirmed_land') return 'land';
      if (p.is_land === true) return 'land';
      if (p.is_water === false) return 'land';
      if (ws === 'confirmed_water') return 'water';
      if (p.is_water === true) return 'water';
      return 'unknown';
    }

    function navidurWaterLandPointId(lat, lon) {
      return Number(lat).toFixed(6) + '_' + Number(lon).toFixed(6);
    }

    async function fetchNavidurWaterLandOverrides() {
      try {
        const r = await fetch('/api?route=water-land-overrides', { cache: 'no-store' });
        if (!r.ok) throw new Error('http_' + r.status);
        const j = await r.json();
        navidurWaterLandOverridesDoc = { points: j && typeof j.points === 'object' && j.points ? j.points : {} };
        return true;
      } catch (err) {
        console.warn('[NAVIDUR] فشل تحميل تصنيفات الماء/اليابسة (Upstash KV) — يُستخدم التصنيف من نقاط التحليل فقط', err);
        navidurWaterLandOverridesDoc = { points: {} };
        return false;
      }
    }

    /** Placeholder: optional land-mask GeoJSON — غير مفعّل حالياً */
    function navidurLandMaskGeojsonClassify(_lat, _lon) {
      return null;
    }

    /** After nearest-source hints: تطبيق أولوية KV ثم قناع جغرافي ثم تصنيف نهائي. */
    function navidurApplyWaterOverridesAndKindsToGrid(gridPoints, overridesDoc) {
      const entries = [];
      const list = Array.isArray(gridPoints) ? gridPoints : [];
      const pts = overridesDoc && overridesDoc.points ? overridesDoc.points : {};
      for (let i = 0; i < list.length; i++) {
        const p = list[i];
        const pid = navidurWaterLandPointId(p.lat, p.lon);
        const kv = pts[pid];
        let source_priority = 'evaluated_points';
        if (kv && kv.status) {
          source_priority = 'kv_override';
          const st = String(kv.status).trim().toLowerCase();
          p.water_status = st;
          if (st === 'confirmed_water') {
            p.is_water = true;
            p.is_land = false;
          } else if (st === 'confirmed_land') {
            p.is_land = true;
            p.is_water = false;
          } else if (st === 'unknown') {
            delete p.is_water;
            delete p.is_land;
            p.water_status = 'unknown';
          }
        } else {
          const g = navidurLandMaskGeojsonClassify(Number(p.lat), Number(p.lon));
          if (g === 'land' || g === 'water') {
            source_priority = 'geojson_mask';
            if (g === 'land') {
              p.water_status = 'confirmed_land';
              p.is_land = true;
              p.is_water = false;
            } else {
              p.water_status = 'confirmed_water';
              p.is_water = true;
              p.is_land = false;
            }
          }
        }
        const kind = navidurClassifyPointWaterKind(p);
        p._nv_water_kind = kind;
        let final_status = 'unknown';
        if (kind === 'land') final_status = 'confirmed_land';
        else if (kind === 'water') final_status = 'confirmed_water';
        entries.push({
          point_id: pid,
          matched_override: !!(kv && kv.status),
          final_status: final_status,
          source_priority: source_priority
        });
      }
      console.debug('NAVIDUR_WATER_LAND_OVERRIDE_APPLIED', { entries: entries });
      return entries;
    }

    function navidurFinalizeGridWaterMeta(gridPoints, sourceEvaluatedPoints) {
      const out = Array.isArray(gridPoints) ? gridPoints : [];
      const src = Array.isArray(sourceEvaluatedPoints) ? sourceEvaluatedPoints : [];
      for (let i = 0; i < out.length; i++) {
        navidurAttachWaterMetaFromNearestSource(out[i], src);
      }
    }

    function navidurFilterAquaticGridPoints(gridPoints) {
      const list = Array.isArray(gridPoints) ? gridPoints : [];
      return list.filter(function (p) {
        const k = p._nv_water_kind != null ? p._nv_water_kind : navidurClassifyPointWaterKind(p);
        return k !== 'land';
      });
    }

    /**
     * 1 center + 8 inner + 16 outer within analysis_radius_deg (default 0.02). Water hints copied from nearest evaluated point when present.
     */
    function buildNavidurDisplayDensityGrid(sourceEvaluatedPoints, station, analysisRadiusDeg) {
      const src = Array.isArray(sourceEvaluatedPoints) ? sourceEvaluatedPoints : [];
      const R = Number(analysisRadiusDeg) > 0 ? Number(analysisRadiusDeg) : 0.02;
      const innerFrac = 0.44;
      const outerFrac = 0.92;
      const centerLat = Number(station.lat);
      const centerLon = Number(station.lng != null ? station.lng : station.lon);
      const phi = (centerLat * Math.PI) / 180;
      let cosPhi = Math.cos(phi);
      if (cosPhi < 0.2) cosPhi = 0.2;

      if (!src.length) {
        return {
          points: [],
          inner_ring_points: 0,
          outer_ring_points: 0,
          source_count: 0
        };
      }

      const out = [];
      const c0 = interpolateScoreZoneFromEvaluated(centerLat, centerLon, src);
      out.push({ lat: centerLat, lon: centerLon, score: c0.score, zone: c0.zone });

      function addRing(count, frac) {
        const r = R * frac;
        for (let k = 0; k < count; k++) {
          const ang = (2 * Math.PI * k) / count - Math.PI / 2;
          let dLat = r * Math.cos(ang);
          let dLon = (r * Math.sin(ang)) / cosPhi;
          let plat = centerLat + dLat;
          let plon = centerLon + dLon;
          const dist = Math.sqrt(dLat * dLat + (dLon * cosPhi) * (dLon * cosPhi));
          if (dist > R + 1e-6) {
            const scale = R / dist;
            dLat *= scale;
            dLon *= scale;
            plat = centerLat + dLat;
            plon = centerLon + dLon;
          }
          const it = interpolateScoreZoneFromEvaluated(plat, plon, src);
          out.push({ lat: plat, lon: plon, score: it.score, zone: it.zone });
        }
        return count;
      }

      const inner_ring_points = addRing(8, innerFrac);
      const outer_ring_points = addRing(16, outerFrac);

      return {
        points: out,
        inner_ring_points: inner_ring_points,
        outer_ring_points: outer_ring_points,
        source_count: src.length
      };
    }

