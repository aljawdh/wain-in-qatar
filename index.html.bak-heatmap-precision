    }

    function normalizeUtcDate(date) {
      const d = new Date(date || new Date());
      return new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate()));
    }

    function getWeekDatesSaturdayToFriday(baseDate) {
      const todayUtc = normalizeUtcDate(baseDate || new Date());
      const day = todayUtc.getUTCDay();
      const daysSinceSaturday = (day + 1) % 7;
      const saturday = new Date(todayUtc.getTime());
      saturday.setUTCDate(saturday.getUTCDate() - daysSinceSaturday);
      const out = [];
      for (let i = 0; i < 7; i++) {
        const d = new Date(saturday.getTime());
        d.setUTCDate(d.getUTCDate() + i);
        out.push(d);
      }
      return out;
    }

    function getVisibleWeekDatesFromToday(baseDate) {
      const allDays = getWeekDatesSaturdayToFriday(baseDate);
      const todayKey = getAppIsoDay(new Date());
      return allDays.filter(function (d) {
        return getAppIsoDay(d) >= todayKey;
      });
    }

    function getTodayKey() {
      return getAppIsoDay(new Date());
    }

    function rebuildDays() {
      // Use timezone-aware today (appTimezone) to match getTodayKey() / getAppIsoDay().
      // normalizeUtcDate() gave UTC midnight which diverges from local midnight by up
      // to UTC offset hours, causing the strip to freeze on the old day after rollover.
      const todayParts = getAppDateParts(new Date());
      const base = new Date(Date.UTC(todayParts.year, todayParts.month - 1, todayParts.day));
      const days = [];
      for (var i = 0; i < 5; i++) {
        var d = new Date(base.getTime());
        d.setUTCDate(d.getUTCDate() + i);
        days.push(d);
      }
      weekDates = days;
    }

