        const data = await res.json();
        const list = Array.isArray(data.stations) ? data.stations.map(mapApiStationToBase).filter(function (st) {
          return st.name && Number.isFinite(st.lat) && Number.isFinite(st.lng) && GULF_COUNTRIES.includes(st.country);
