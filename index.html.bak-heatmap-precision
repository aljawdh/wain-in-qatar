    function navidurStopCastLiveTracking() {
      if (navidurCastWatchId != null && navigator.geolocation) {
        try {
          navigator.geolocation.clearWatch(navidurCastWatchId);
        } catch (_e) { /* ignore */ }
        navidurCastWatchId = null;
      }
      if (navidurCastPollTimer != null) {
        clearInterval(navidurCastPollTimer);
        navidurCastPollTimer = null;
      }
    }

    function navidurStartCastLiveTracking() {
      navidurStopCastLiveTracking();
      if (!navidurCastLiveEnabled || !navigator.geolocation || !navidurCastGeo.sessionStarted) return;
      navidurCastWatchId = navigator.geolocation.watchPosition(
        function (pos) {
          navidurCastGeo.lat = Number(pos.coords.latitude);
          navidurCastGeo.lon = Number(pos.coords.longitude);
          navidurCastGeo.error = false;
          const statusEl = document.getElementById('castDirectionStatus');
          if (statusEl) statusEl.textContent = '';
          navidurRefreshCastDirectionMapAndUi();
        },
        function () {
          navidurCastGeo.error = true;
          const statusEl = document.getElementById('castDirectionStatus');
          if (statusEl) statusEl.textContent = 'تعذر تحديد موقعك الحالي';
          navidurRefreshCastDirectionMapAndUi();
        },
        { enableHighAccuracy: true, maximumAge: 10000, timeout: 20000 }
      );
      navidurCastPollTimer = setInterval(function () {
        if (!navidurCastLiveEnabled || !navigator.geolocation) return;
        navigator.geolocation.getCurrentPosition(
          function (pos) {
            navidurCastGeo.lat = Number(pos.coords.latitude);
            navidurCastGeo.lon = Number(pos.coords.longitude);
            navidurCastGeo.error = false;
            const statusEl = document.getElementById('castDirectionStatus');
            if (statusEl) statusEl.textContent = '';
            navidurRefreshCastDirectionMapAndUi();
          },
          function () { /* silent — watch handles errors */ },
          { enableHighAccuracy: true, maximumAge: 12000, timeout: 12000 }
        );
      }, 12000);
    }

    function navidurRequestCastGeolocation() {
      if (!navigator.geolocation) {
        navidurCastGeo.error = true;
        navidurCastGeo.sessionStarted = true;
        const statusEl = document.getElementById('castDirectionStatus');
        if (statusEl) statusEl.textContent = 'تعذر تحديد موقعك الحالي';
        navidurRefreshCastDirectionMapAndUi();
        return;
      }
      navidurCastGeo.sessionStarted = true;
      navidurCastFittedOnce = false;
      const liveBtn = document.getElementById('castLiveToggleBtn');
      if (liveBtn) {
        liveBtn.style.display = 'inline-block';
        liveBtn.textContent = navidurCastLiveEnabled ? 'إيقاف التحديث اللحظي' : 'تفعيل التحديث اللحظي';
      }
      navigator.geolocation.getCurrentPosition(
        function (pos) {
          navidurCastGeo.lat = Number(pos.coords.latitude);
          navidurCastGeo.lon = Number(pos.coords.longitude);
          navidurCastGeo.error = false;
          const statusEl = document.getElementById('castDirectionStatus');
          if (statusEl) statusEl.textContent = '';
          navidurStartCastLiveTracking();
          navidurRefreshCastDirectionMapAndUi();
        },
        function () {
          navidurCastGeo.error = true;
          const statusEl = document.getElementById('castDirectionStatus');
          if (statusEl) statusEl.textContent = 'تعذر تحديد موقعك الحالي';
          navidurRefreshCastDirectionMapAndUi();
        },
        { enableHighAccuracy: true, timeout: 14000, maximumAge: 0 }
      );
    }

    function navidurRefreshCastDirectionMapAndUi() {
      const lineEl = document.getElementById('castDirectionLine');
      const statusEl = document.getElementById('castDirectionStatus');
      const hbest = latestNavidurHotspotBest;
      const hlat = hbest && hbest.center_lat != null ? Number(hbest.center_lat) : null;
      const hlon = hbest && hbest.center_lon != null ? Number(hbest.center_lon) : null;
      const avgScore = hbest != null && hbest.avg_score != null ? Number(hbest.avg_score) : null;
      const ulat = navidurCastGeo.lat;
      const ulon = navidurCastGeo.lon;

      const debugPayload = {
        user_lat: ulat,
        user_lng: ulon,
        hotspot_lat: isFinite(hlat) ? hlat : null,
        hotspot_lng: isFinite(hlon) ? hlon : null,
        bearing_deg: null,
        direction_text: null,
        distance_m: null,
        avg_score: avgScore
      };

      if (!hbest || !isFinite(hlat) || !isFinite(hlon)) {
        navidurClearCastMapOverlays();
        if (lineEl) lineEl.textContent = 'لا يوجد اتجاه رمي واضح الآن';
        console.debug('NAVIDUR_CAST_DIRECTION', debugPayload);
        return;
      }

      if (ulat == null || ulon == null || !isFinite(ulat) || !isFinite(ulon)) {
        navidurClearCastMapOverlays();
        if (navidurCastGeo.error && navidurCastGeo.sessionStarted) {
          if (lineEl) lineEl.textContent = 'تعذر تحديد موقعك الحالي';
          if (statusEl) statusEl.textContent = 'تعذر تحديد موقعك الحالي';
        } else {
          if (lineEl) lineEl.textContent = 'فعّل موقعي لعرض اتجاه الرمي.';
          if (statusEl && !navidurCastGeo.error) statusEl.textContent = '';
        }
        console.debug('NAVIDUR_CAST_DIRECTION', debugPayload);
        return;
      }

      const bearing = bearingDegFromTo(ulat, ulon, hlat, hlon);
      const dirText = windDirText8(bearing);
      const rawM = haversineKm(ulat, ulon, hlat, hlon) * 1000;
      const distRounded = roundCastDistanceM(rawM);
      debugPayload.bearing_deg = bearing;
      debugPayload.direction_text = dirText;
      debugPayload.distance_m = distRounded;

      if (lineEl) {
        if (rawM < 10) {
          lineEl.textContent = 'أنت قريب جدًا من أفضل نقطة — قوة ' + Math.round(avgScore || 0) + '%';
        } else {
          lineEl.textContent =
            'اتجاه الرمي: ' + dirText + ' — ' + distRounded + 'م — قوة ' + Math.round(avgScore || 0) + '%';
        }
      }
      if (statusEl && !navidurCastGeo.error) statusEl.textContent = '';

      if (!stationMap) {
        console.debug('NAVIDUR_CAST_DIRECTION', debugPayload);
        return;
      }

      navidurClearCastMapOverlays();
      const lineColor = navidurCastLineColor(avgScore);
      navidurCastOverlayGroup = L.layerGroup();
      const pl = L.polyline([[ulat, ulon], [hlat, hlon]], {
        color: lineColor,
        weight: 4,
        opacity: 0.9
      });
      navidurCastOverlayGroup.addLayer(pl);

      const baseMid = navidurDestinationFrom(hlat, hlon, bearing + 180, 42);
      const left = navidurDestinationFrom(baseMid.lat, baseMid.lon, bearing - 90, 20);
      const right = navidurDestinationFrom(baseMid.lat, baseMid.lon, bearing + 90, 20);
      const arrow = L.polygon([[hlat, hlon], [left.lat, left.lon], [right.lat, right.lon]], {
        color: lineColor,
        fillColor: lineColor,
        fillOpacity: 0.92,
        weight: 2
      });
      navidurCastOverlayGroup.addLayer(arrow);

      const targetIcon = L.divIcon({
        className: 'nv-cast-target-ico',
        html: '<span>Target</span>',
        iconSize: [52, 20],
        iconAnchor: [26, 28]
      });
      navidurCastOverlayGroup.addLayer(L.marker([hlat, hlon], { icon: targetIcon, zIndexOffset: 350 }));

      navidurCastUserMarker = L.circleMarker([ulat, ulon], {
        radius: 8,
        color: '#0f766e',
        weight: 2,
        fillColor: '#5eead4',
        fillOpacity: 0.92,
        className: 'navidur-cast-user-marker'
      });
      navidurCastUserMarker.bindPopup('موقعك — اتجاه الرمي');

      navidurCastOverlayGroup.addTo(stationMap);
      navidurCastUserMarker.addTo(stationMap);

      if (navidurCastGeo.sessionStarted && !navidurCastFittedOnce) {
        navidurCastFittedOnce = true;
        try {
          stationMap.fitBounds(L.latLngBounds([[ulat, ulon], [hlat, hlon]]), { padding: [52, 52], maxZoom: 15, animate: true });
        } catch (_e) { /* ignore */ }
      }

      console.debug('NAVIDUR_CAST_DIRECTION', debugPayload);
    }

