    function renderGridOnMap(result, station) {
      if (!stationMap || !station || !result) return;

      teardownAnalysisHeatExtras();

      if (evaluatedLayer) {
        evaluatedLayer.clearLayers();
      }

      const radiusDegrees = result.search_area && result.search_area.radius != null ? result.search_area.radius : 0.02;
      const rawEvaluated = Array.isArray(result.evaluated_points) ? result.evaluated_points : [];
      const dens = buildNavidurDisplayDensityGrid(rawEvaluated, station, radiusDegrees);
      navidurFinalizeGridWaterMeta(dens.points, rawEvaluated);
      navidurApplyWaterOverridesAndKindsToGrid(dens.points, navidurWaterLandOverridesDoc);
      const pointsAll = dens.points;
      const aquaticPoints = navidurFilterAquaticGridPoints(pointsAll);
      const landRemoved = pointsAll.filter(function (p) {
        return navidurClassifyPointWaterKind(p) === 'land';
      }).length;
      const unknownPointsCount = pointsAll.filter(function (p) {
        return navidurClassifyPointWaterKind(p) === 'unknown';
      }).length;
      const usedWaterFields = navidurCollectWaterFieldsUsed(rawEvaluated);
      let waterFilterReason = 'nearest_source_water_metadata';
      if (!usedWaterFields.length) {
        waterFilterReason = 'no_water_fields_on_source_points_all_unknown';
      } else if (unknownPointsCount === pointsAll.length && pointsAll.length > 0) {
        waterFilterReason = 'all_grid_points_unknown_water_class';
      }
      if (unknownPointsCount > 0 && usedWaterFields.length) {
        console.warn('NAVIDUR_WATER_FILTER: بعض نقاط الشبكة بلا تصنيف ماء/يابسة صريح — تُعامل كمائية مؤقتًا', {
          unknown_points: unknownPointsCount
        });
      }

      const insufficientAquatic = aquaticPoints.length < 3;
      const mapBestIdx = navidurDisplayGridFindBestIdx(aquaticPoints, result.best_spot);

      console.debug('NAVIDUR_GRID_DENSITY', {
        total_points: pointsAll.length,
        inner_ring_points: dens.inner_ring_points,
        outer_ring_points: dens.outer_ring_points,
        analysis_radius: radiusDegrees,
        points_used_for_heatmap: insufficientAquatic ? 0 : aquaticPoints.length,
        points_used_for_hotspot: insufficientAquatic ? 0 : aquaticPoints.length
      });

      console.debug('NAVIDUR_WATER_POINT_FILTER', {
        total_points_before: pointsAll.length,
        water_points_after: aquaticPoints.length,
        land_points_removed: landRemoved,
        unknown_points_count: unknownPointsCount,
        reason: waterFilterReason,
        used_fields: usedWaterFields,
        heatmap_points_used: insufficientAquatic ? 0 : aquaticPoints.length,
        hotspot_points_used: insufficientAquatic ? 0 : aquaticPoints.length
      });

      const sampleToggleEl = document.getElementById('toggleShowSamplePoints');
      const showSamplePoints = !!(sampleToggleEl && sampleToggleEl.checked);
      if (showSamplePoints && aquaticPoints.length) {
        const displayVisuals = computeMapPointDisplayVisuals(aquaticPoints);
        aquaticPoints.forEach(function (p, idx) {
          const isBest = mapBestIdx === idx;
          const disp = displayVisuals[idx] || { finalVisual: getScoreVisual(p.score || 0), rawVisual: getScoreVisual(p.score || 0), is_outlier: false };
          const visual = disp.finalVisual;
          const gridMarker = L.circleMarker([p.lat, p.lon], {
            radius: isBest ? 11 : 6,
            color: isBest ? '#ffffff' : visual.color,
            fillColor: isBest ? visual.fill : visual.fill,
            fillOpacity: isBest ? 0.98 : 0.82,
            weight: isBest ? 3 : 1.5
          });
          gridMarker.bindPopup(
            'Score: ' + p.score + '<br>Zone: ' + p.zone +
              (disp.is_outlier ? '<br><small>عرض ملسّن (لون فقط)</small>' : '') +
              (isBest ? '<br><strong>BEST SPOT</strong>' : '')
          );
          gridMarker.addTo(evaluatedLayer);
        });
      }

      const heatMeta = insufficientAquatic ? addAnalysisHeatmapLayer([]) : addAnalysisHeatmapLayer(aquaticPoints);

      if (analysisCircle) {
        analysisCircle.remove();
      }
      analysisCircle = L.circle([station.lat, station.lng], {
        radius: Math.round(radiusDegrees * 111000),
        color: '#7ed9ff',
        weight: 1.2,
        fillColor: '#4db7e8',
        fillOpacity: 0.08
      }).addTo(stationMap);

      updateHotspotClusterUi(result, station, aquaticPoints, heatMeta, { insufficientAquatic: insufficientAquatic });

      const heatToggleEl = document.getElementById('toggleAnalysisHeatmap');
      console.debug('NAVIDUR_SAMPLE_POINTS_VISIBILITY', {
        sample_points_count: aquaticPoints.length,
        visible: showSamplePoints,
        heatmap_enabled: !heatToggleEl || heatToggleEl.checked,
        hotspot_enabled: !!latestNavidurHotspotBest
      });
    }

