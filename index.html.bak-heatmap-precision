    .compass-wrap { display: grid; gap: 12px; margin-bottom: 14px; }
    .compass {
      width: 220px;
      height: 220px;
      margin: 0 auto;
      border-radius: 50%;
      border: 2px solid rgba(255,255,255,0.2);
      position: relative;
      background: radial-gradient(circle at 50% 45%, #10314a, #081a2a);
    }
    .needle {
      width: 0;
      height: 0;
      position: absolute;
      left: 50%;
      top: 50%;
      transform-origin: 50% 115px;
      transform: translate(-50%, -115px) rotate(0deg);
      filter: drop-shadow(0 2px 4px rgba(0,0,0,0.35));
    }
    .needle::before {
      content: '';
      position: absolute;
      left: -2px;
      top: 2px;
      width: 4px;
      height: 86px;
      border-radius: 99px;
      background: linear-gradient(180deg, #e9f8ff, #62d6ff);
      box-shadow: 0 0 8px rgba(98, 214, 255, 0.45);
    }
    .needle::after {
      content: '';
      position: absolute;
      left: -8px;
      top: -10px;
      width: 16px;
      height: 18px;
      clip-path: polygon(50% 0, 100% 100%, 0 100%);
      background: #a8ecff;
      filter: drop-shadow(0 0 6px rgba(111,220,255,0.6));
    }
    .center {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      background: #03111c;
      border: 1px solid rgba(255,255,255,0.2);
      width: 74px;
      height: 74px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      font-weight: 900;
    }
    .compass-label {
      position: absolute;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.2px;
      color: #d3edf9;
      transform: translate(-50%, -50%);
      text-shadow: 0 1px 2px rgba(0,0,0,0.45);
      white-space: nowrap;
    }
