    function updateHotspotClusterUi(result, station, points, heatMeta, waterUi) {
      waterUi = waterUi || {};
      const summaryEl = document.getElementById('hotspotSummaryText');
      const list = Array.isArray(points) ? points : [];
      let reason_if_no_hotspot = '';
      const heatmap_points_count = heatMeta && heatMeta.triplets ? heatMeta.triplets.length : 0;

      if (waterUi.insufficientAquatic) {
        latestNavidurHotspotBest = null;
        if (analysisHotspotMarker && stationMap) {
          try {
            stationMap.removeLayer(analysisHotspotMarker);
          } catch (_e) { /* ignore */ }
          analysisHotspotMarker = null;
        }
        if (summaryEl) summaryEl.textContent = 'نقاط مائية غير كافية لتكوين هوتسبوت واضح';
        navidurRefreshCastDirectionMapAndUi();
        console.debug('NAVIDUR_HEATMAP_HOTSPOT', {
          heatmap_points_count: 0,
          clusters_count: 0,
          best_cluster: null,
          avg_score: null,
          max_score: null,
          direction_from_station: null,
          distance_from_station_m: null,
          reason_if_no_hotspot: 'insufficient_aquatic_points_after_land_filter'
        });
        return;
      }

      if (!list.length) {
        latestNavidurHotspotBest = null;
        reason_if_no_hotspot = 'لا توجد نقاط تحليل';
        if (summaryEl) summaryEl.textContent = 'لا يوجد هوتسبوت واضح؛ النشاط متشتت أو ضعيف.';
        console.debug('NAVIDUR_HEATMAP_HOTSPOT', {
          heatmap_points_count: 0,
          clusters_count: 0,
          best_cluster: null,
          avg_score: null,
          max_score: null,
          direction_from_station: null,
          distance_from_station_m: null,
          reason_if_no_hotspot: reason_if_no_hotspot
        });
        navidurRefreshCastDirectionMapAndUi();
        return;
      }

      if (heatMeta && !heatMeta.heat_ok && heatMeta.heat_error) {
        reason_if_no_hotspot = reason_if_no_hotspot || 'تعذر عرض الحرارة: ' + heatMeta.heat_error;
      }

      const hs = clusterHighActivityHotspot(list, station);
      const clusters_count = hs.clusters.length;
      const best = hs.best;
      const best_cluster = best
        ? {
          center_lat: best.center_lat,
          center_lon: best.center_lon,
          point_count: best.point_count,
          avg_score: best.avg_score,
          max_score: best.max_score
        }
        : null;

      if (!hs.highIdx.length) {
        reason_if_no_hotspot = reason_if_no_hotspot || 'لا توجد نقاط بنشاط عالٍ كافٍ داخل الشبكة';
      } else if (!hs.clusters.length) {
        reason_if_no_hotspot =
          reason_if_no_hotspot ||
          ('لا يوجد هوتسبوت واضح داخل نطاق التحليل — يتطلب تجمّع ' + hs.minCluster + ' نقاط قريبة عالية');
      }

      let summaryText = 'لا يوجد هوتسبوت واضح؛ النشاط متشتت أو ضعيف.';
      if (best && hs.direction_from_station != null && hs.distance_from_station_m != null) {
        summaryText =
          'أفضل نشاط مرصود: ' +
          hs.direction_from_station +
          ' المحطة — ' +
          Math.round(hs.distance_from_station_m) +
          'م — قوة ' +
          Math.round(best.avg_score) +
          '%';
        if (stationMap) {
          analysisHotspotMarker = L.circleMarker([best.center_lat, best.center_lon], {
            radius: 11,
            color: '#c084fc',
            weight: 2,
            fillColor: '#f5d0fe',
            fillOpacity: 0.38,
            className: 'navidur-hotspot-marker'
          });
          analysisHotspotMarker.bindPopup(
            '<strong>Hotspot</strong><br>متوسط النقاط: ' +
              best.avg_score.toFixed(1) +
              '<br>أعلى نقطة: ' +
              best.max_score +
              '<br>عدد النقاط: ' +
              best.point_count
          );
          analysisHotspotMarker.addTo(stationMap);
        }
      } else if (hs.clusters.length === 0 && hs.highIdx.length > 0) {
        summaryText = 'لا يوجد هوتسبوت واضح داخل نطاق التحليل';
      }

      if (summaryEl) summaryEl.textContent = summaryText;

      if (best && best.center_lat != null && best.center_lon != null) {
        latestNavidurHotspotBest = {
          center_lat: best.center_lat,
          center_lon: best.center_lon,
          avg_score: best.avg_score
        };
      } else {
        latestNavidurHotspotBest = null;
      }
      navidurRefreshCastDirectionMapAndUi();

      console.debug('NAVIDUR_HEATMAP_HOTSPOT', {
        heatmap_points_count: heatmap_points_count,
        clusters_count: clusters_count,
        best_cluster: best_cluster,
        avg_score: best ? best.avg_score : null,
        max_score: best ? best.max_score : null,
        direction_from_station: hs.direction_from_station,
        distance_from_station_m: hs.distance_from_station_m,
        reason_if_no_hotspot: best ? (reason_if_no_hotspot || '') : (reason_if_no_hotspot || summaryText)
      });
    }

