        analysisHeatLayer = null;
        return { triplets: triplets, heat_ok: false, heat_error: String(err && err.message ? err.message : err) };
      }
    }

    function roundCastDistanceM(meters) {
      if (!isFinite(meters)) return 0;
      if (meters < 150) return Math.round(meters / 5) * 5;
      return Math.round(meters / 10) * 10;
    }

    function navidurCastLineColor(avgScore) {
      const t = Math.max(0, Math.min(1, (Number(avgScore) || 0) / 100));
      const r = Math.round(56 + (220 - 56) * t);
      const g = Math.round(189 + (38 - 189) * t);
      const b = Math.round(248 + (38 - 248) * t);
      return 'rgb(' + r + ',' + g + ',' + b + ')';
    }

    /** Destination point from (lat,lon) moving bearingDeg (0=north) for distM meters. */
    function navidurDestinationFrom(lat, lon, bearingDeg, distM) {
      const toRad = Math.PI / 180;
      const R = 6371000;
      const δ = distM / R;
      const θ = bearingDeg * toRad;
      const φ1 = lat * toRad;
      const λ1 = lon * toRad;
      const sinφ1 = Math.sin(φ1);
      const cosφ1 = Math.cos(φ1);
      const sinδ = Math.sin(δ);
      const cosδ = Math.cos(δ);
      const sinφ2 = sinφ1 * cosδ + cosφ1 * sinδ * Math.cos(θ);
      const φ2 = Math.asin(sinφ2);
      const y = Math.sin(θ) * sinδ * cosφ1;
      const x = cosδ - sinφ1 * sinφ2;
      const λ2 = λ1 + Math.atan2(y, x);
      return {
        lat: φ2 / toRad,
        lon: (((λ2 / toRad) + 540) % 360) - 180
      };
    }

