      if (score >= 80) return { label: 'High', cls: 'high', labelAr: 'عالية' };
      if (score >= 60) return { label: 'Medium', cls: 'medium', labelAr: 'متوسطة' };
      return { label: 'Low', cls: 'low', labelAr: 'منخفضة' };
    }

