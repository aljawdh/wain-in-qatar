    // Layer 2 (local marine state) is the authoritative source for حمل/فساد.
    // waterStateOverride supplies the live tidal decision when available.
    // Falls back to lunar cycle only when live data is absent.
    function getFishForStation(date, waterStateOverride) {
      const region = getMarineRegion(selectedStation);
      const p = getAppDateParts(date);
      const monthCode = getMonthCode(p.month);
      const dar = getCurrentDar(date);
      const isFasad = waterStateOverride != null
        ? (waterStateOverride === 'فساد')
        : (getHamalFasadStatus(date).name === 'فساد');
      const darLabel = (dar.darName.split(' - ')[1] || dar.darName);

      const pool = FISH_SPECIES_DATABASE.filter(function (f) { return f.regions.includes(region); });
      const ids = FISHING_CALENDAR[monthCode] || [];
      const seasonal = pool.filter(function (f) { return ids.includes(f.id); });
      const base = seasonal.length ? seasonal : pool;

      const ranked = base.map(function (f) {
        const isPeakDar = dar.dar >= f.peak_min && dar.dar <= f.peak_max;
        const modeMatch = isFasad ? f.prefer_fasad : !f.prefer_fasad;
        let priority = 0;

        if (modeMatch)  priority += 25;
        if (!modeMatch) priority -= 8;

        if (f.type === 'ساحلي' && !isFasad) priority += 15;
        if (f.type === 'قاعي'  &&  isFasad) priority += 15;
        if (f.type === 'سطحي') priority += 8;

        if (!isFasad && (f.id === 'shaam' || f.id === 'sobaity' || f.id === 'balool' || f.id === 'safi' || f.id === 'badah')) {
          priority += 20;
        }
        if (isFasad && (f.id === 'hamour' || f.id === 'sooli' || f.id === 'andaq' || f.id === 'faskar' || f.id === 'kofar')) {
          priority += 20;
        }

        if (isPeakDar) priority += 12;

        if (f.focus_stations && f.focus_stations.some(function (s) {
          return selectedStation.name.includes(s) || s.includes(selectedStation.name);
        })) {
          priority += 10;
        }

        const stationPriorityIndex = selectedStation.speciesPriority.indexOf(f.id);
        if (stationPriorityIndex >= 0) {
          priority += 35 - (stationPriorityIndex * 4);
        }

        if (selectedStation.bathymetry === 'shallow' && f.type === 'ساحلي') priority += 10;
        if (selectedStation.bathymetry === 'deep' && (f.type === 'قاعي' || f.type === 'سطحي')) priority += 10;

        return {
          tag: f.tag || '',
          prefer_fasad: f.prefer_fasad,
          focus_stations: f.focus_stations,
          id: f.id, name_ar: f.name_ar, name_en: f.name_en,
          type: f.type, regions: f.regions,
          best_time: f.best_time, rig: f.rig, bait: f.bait,
          methods: f.methods, durur: f.durur,
          peak_min: f.peak_min, peak_max: f.peak_max,
          mode: (f.type === 'قاعي' || f.type === 'سطحي') ? 'deep' : 'coastal',
          priority,
          seasonLabel: isPeakDar ? 'ذروة الموسم' : 'نشط'
        };
      });

      return ranked.sort(function (a, b) {
        if (b.priority !== a.priority) return b.priority - a.priority;
        return a.name_ar.localeCompare(b.name_ar, 'ar');
      }).slice(0, 10);
    }

    // waterStateOverride: pass live tidal waterState when available to align
    // fish scoring with the authoritative per-station marine decision.
    function scoreFish(fish, hr, date, waterStateOverride) {
      const isFasad = waterStateOverride != null
        ? (waterStateOverride === 'فساد')
        : (getHamalFasadStatus(date).name === 'فساد');
      const ws = mpsToKmh(hr.windSpeed && hr.windSpeed.sg != null ? hr.windSpeed.sg : 0) || 0;
      const sea = hr.seaLevel && hr.seaLevel.sg != null ? hr.seaLevel.sg : 0.4;
      const dar = getCurrentDar(date).dar;
      const peakBoost  = dar >= fish.peak_min && dar <= fish.peak_max ? 16 : -6;
      const modeMatch  = isFasad ? fish.prefer_fasad : !fish.prefer_fasad;
      const modeAdj    = modeMatch ? 14 : -10;
      const windAdj    = isFasad
        ? (ws <= 20 ? 8 : ws <= 30 ? -8 : -24)
        : (ws <= 14 ? 10 : ws <= 24 ? -4 : -18);
      const seaAdj     = sea >= 0.4 && sea <= 0.75 ? 8 : -6;
      const total      = 58 + peakBoost + modeAdj + windAdj + seaAdj;
      return Math.max(1, Math.min(100, Math.round(total)));
    }

