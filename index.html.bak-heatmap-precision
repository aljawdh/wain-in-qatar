      let speciesFallback = [];

      if (dto && fishing) {
        const rec = Array.isArray(fishing.fish_recommendations) ? fishing.fish_recommendations : [];
        if (rec.length > 0) {
          source = 'engine_recommendations';
          engineRecs = rec;
        } else {
          const act = Array.isArray(fishing.species_activity) ? fishing.species_activity.filter(Boolean) : [];
          if (act.length > 0) {
            source = 'engine_species_activity';
            speciesFallback = act;
          }
        }
      }

      root.innerHTML = '';

      if (source === 'engine_recommendations') {
        console.debug('[NAVIDUR fish list]', { source: 'engine_recommendations', count: engineRecs.length, trip_confidence_score: fishing.confidence_score });
        engineRecs.forEach(function (rec) {
          const el = document.createElement('div');
          el.className = 'fish-item';
          const name = rec.fish_name_ar || '—';
          const fs = rec.score != null ? rec.score : '—';
          const reason = rec.reason_ar || '';
          const methods = Array.isArray(rec.recommended_methods) ? rec.recommended_methods.join('، ') : '';
          const zone = [rec.zone, rec.habitat].filter(Boolean).join(' • ');
          const depthLine = formatEngineDepthM(rec.depth_m);
          const pref = formatWaterStatePrefAr(rec.water_state_pref);
          const metaParts = [];
          if (zone) metaParts.push(zone);
          if (depthLine) metaParts.push('العمق: ' + depthLine);
          if (pref) metaParts.push('تفضيل الماء: ' + pref);
          const reasonShort = reason.length > 240 ? reason.slice(0, 240) + '…' : reason;
          const wBar = typeof rec.score === 'number' ? Math.min(100, Math.max(0, rec.score)) : 0;
          el.innerHTML =
            '<div class="fish-row"><div>' +
              '<div class="fish-name">' + nvEscapeHtml(name) + '</div>' +
              '<div class="fish-meta" style="font-size:12px;opacity:.9">' + nvEscapeHtml(metaParts.join(' • ')) + '</div>' +
              '<div class="fish-meta" style="font-size:12px;margin-top:4px;line-height:1.35">' + nvEscapeHtml(reasonShort) + '</div>' +
              (methods ? '<div class="fish-meta" style="font-size:11px;margin-top:4px;color:#8db2c8">الطرق: ' + nvEscapeHtml(methods) + '</div>' : '') +
            '</div><div class="score" title="درجة السمكة (محرك NAVIDUR)">' + nvEscapeHtml(String(fs)) + (typeof fs === 'number' ? '%' : '') + '</div></div>' +
            '<div class="bar"><span style="width:' + wBar + '%"></span></div>';
          el.addEventListener('click', function () { showEngineFishRecommendation(rec); });
          root.appendChild(el);
        });
        return;
      }

      if (source === 'engine_species_activity') {
        console.debug('[NAVIDUR fish list]', { source: 'engine_species_activity', names: speciesFallback.slice(), trip_confidence_score: fishing.confidence_score });
        speciesFallback.forEach(function (name) {
          const el = document.createElement('div');
          el.className = 'fish-item';
          el.innerHTML =
            '<div class="fish-row"><div>' +
              '<div class="fish-name">' + nvEscapeHtml(name) + '</div>' +
              '<div class="fish-meta">قائمة أسماء من المحرك (بدون تفاصيل درجة لكل نوع)</div>' +
            '</div><div class="score">—</div></div>';
          el.addEventListener('click', function () {
            document.getElementById('modalFishName').textContent = name;
            document.getElementById('modalFishNameEn').textContent = '—';
            document.getElementById('modalFishType').textContent = 'توصية المحرك';
            document.getElementById('modalFishBestTime').textContent = '—';
            document.getElementById('modalFishRig').textContent = '—';
            document.getElementById('modalFishBait').textContent = '—';
            document.getElementById('modalFishMethods').textContent = '—';
            document.getElementById('modalFishDurur').textContent = '—';
            document.getElementById('modalFishTag').textContent = '—';
            document.getElementById('fishModal').style.display = 'block';
          });
          root.appendChild(el);
        });
        return;
      }

      console.debug('[NAVIDUR fish list]', { source: 'local_fallback' });
      const hr = getSelectedHourEntry().hour || {};
      const dorahLabel = (getCurrentDar(date).darName.split(' - ')[1] || getCurrentDar(date).darName);
      const _stState = stationStates && selectedStation ? stationStates[selectedStation.id] : null;
      const liveWaterState = _stState && _stState.waterState ? _stState.waterState : null;
      const fish = getFishForStation(date, liveWaterState)
        .map(function (f) { return Object.assign({}, f, { score: scoreFish(f, hr, date, liveWaterState) }); })
        .sort(function (a, b) {
          if ((b.priority || 0) !== (a.priority || 0)) return (b.priority || 0) - (a.priority || 0);
          return b.score - a.score;
        })
        .slice(0, 10);

      if (!fish.length) {
        root.innerHTML = '<div class="empty">لا توجد أسماك مطابقة حالياً.</div>';
        return;
      }

      fish.forEach(function (f) {
        const el = document.createElement('div');
        el.className = 'fish-item';
        const tagHtml = f.tag
          ? '<span class="fish-tag ' + getTagClass(f.tag) + '">' + f.tag + '</span>'
          : '';
        el.innerHTML =
          '<div class="fish-row"><div>' +
            '<div class="fish-name">' + f.name_ar + '</div>' +
            '<div class="fish-meta">' + f.seasonLabel + ' • ' + dorahLabel + ' • نموذج محلي (طوارئ)</div>' +
            (tagHtml ? '<div>' + tagHtml + '</div>' : '') +
          '</div><div class="score" title="درجة محلية (ليست محرك الخادم)">' + f.score + '%</div></div>' +
          '<div class="bar"><span style="width:' + f.score + '%"></span></div>';
        el.addEventListener('click', function () { showFishModal(f); });
        root.appendChild(el);
      });
    }

    function renderHero(date) {
      updatePublicHeaderBar();
      if (window.NavidurLiveAnalysis && typeof window.NavidurLiveAnalysis.renderEnvironment === 'function') {
        window.NavidurLiveAnalysis.renderEnvironment(
          window.NavidurLiveAnalysis.normalizeDisplayEnv(currentSharedAnalysisDto)
        );
      }
      if (currentSharedAnalysisDto && currentSharedAnalysisDto.environment && currentSharedAnalysisDto.dur) {
        const d = currentSharedAnalysisDto.dur;
        const durRef = d.reference || null;
        const tideDisplayRaw = getSharedTideDisplayArabic();
        const tideDisplay = tideDisplayRaw || 'غير متاح حالياً';
        const tideBadgeClass = tideDisplayRaw === 'سقي' ? 'tide-up' : tideDisplayRaw === 'ثبر' ? 'tide-down' : 'tide-turn';
        const activeModeFromDto = getSharedFishingMode() || getActiveMode(date);
        const escapeHtml = function (value) {
          return String(value == null ? '' : value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
        };
        const unknown = 'غير معروف';
        const durNotes = durRef ? [durRef.description_ar, durRef.notes_ar].filter(function (item, index, arr) {
          return item && arr.indexOf(item) === index;
        }) : [];
        const seasonalEventNames = durRef
          ? ((durRef.seasonal_event_names && durRef.seasonal_event_names.length ? durRef.seasonal_event_names : (durRef.seasonal_events || []).map(function (item) {
              return item && (item.name_ar || item.name || item.id) || '';
            })).filter(Boolean))
          : [];
        const renderRefList = function (label, values) {
          return values && values.length ? '<div><strong>' + escapeHtml(label) + ':</strong> ' + values.map(escapeHtml).join('، ') + '</div>' : '';
        };
        const refHtml = durRef ? [
          '<div><strong>الموسم (مرجع):</strong> ' + escapeHtml(durRef.season_ar || unknown) + '</div>',
          '<div><strong>المعنى التراثي:</strong> ' + escapeHtml(durRef.heritage_meaning_ar || unknown) + '</div>',
          durNotes.length ? '<div><strong>وصف / ملاحظات:</strong> ' + durNotes.map(escapeHtml).join(' | ') + '</div>' : '',
          renderRefList('سمات الطقس (مرجع الدر)', durRef.weather_traits || []),
          renderRefList('سمات البحر', durRef.marine_traits || []),
          renderRefList('سمات السمك', durRef.fish_traits || []),
          renderRefList('أحداث موسمية', seasonalEventNames)
        ].filter(Boolean).join('') : '—';
        const setText = function (id, val) { const el = document.getElementById(id); if (el) el.textContent = val; };
        setText('dateLine', formatDateArabic(new Date()) + ' • ' + (selectedStation && selectedStation.name));
        setText('moonIcon', '🌊');
        setText('dorahName', d.period_name || 'غير معروف');
        setText('durDayInPeriodVal', d.day_in_period != null ? String(d.day_in_period) : unknown);
        setText('durElapsedVal', d.day_in_period != null ? String(d.day_in_period) : unknown);
        setText('countdownDays', d.days_remaining != null ? (String(d.days_remaining) + ' يوم') : unknown);
        setText('dorahDetail', 'التالي: ' + (d.next_period_name || unknown) + (durRef && durRef.season_ar ? ' — الموسم: ' + durRef.season_ar : ''));
        const pr = d.period_start && d.period_end ? (d.period_start + ' → ' + d.period_end) : unknown;
        setText('durPeriodRangeVal', pr);
        setText('dorahCountdownLine', d.days_remaining != null ? ('تبقى ' + d.days_remaining + ' يوماً على نهاية هذا الدر') : '');
        (function setInfo() { const el = document.getElementById('dorahInfoBox'); if (el) el.innerHTML = refHtml; }());
        (function warnTide() {
          const fishingWater = getSharedFishingWaterLabelAr();
          const parts = [];
          if (fishingWater) parts.push('حالة الماء للصيد: ' + fishingWater);
          if (tideDisplayRaw) parts.push('اتجاه المد: ' + tideDisplayRaw);
          setText('dorahWarning', parts.join(' — '));
        }());
        document.getElementById('currentWaterHeight').innerHTML = 'اتجاه المد: <span class="tide-dir-badge ' + tideBadgeClass + '">' + tideDisplay + '</span>';
        document.getElementById('coastalBtn').classList.toggle('active', activeModeFromDto === 'coastal');
        document.getElementById('deepBtn').classList.toggle('active', activeModeFromDto === 'deep');
        const statusEl = document.getElementById('windOfficialStatus');
        if (statusEl) statusEl.style.display = 'none';
        updateIntelBlock();
        void nvRefreshSuhailFromTrueFinal();
        return;
      }
      const hasEnvDto = currentSharedAnalysisDto && currentSharedAnalysisDto.environment;
      const dar = getCurrentDar(date);
      const moon = getMoonPhase(date);
      const activeMode = getActiveMode(date);
      const hr = getSelectedHourEntry().hour || {};
      const sea = hr.seaLevel && hr.seaLevel.sg != null ? hr.seaLevel.sg : null;
      const activeHours = getActiveHours();
      const cur = sea;
      const prev = selectedHourIndex > 0
        ? (activeHours[selectedHourIndex - 1] && activeHours[selectedHourIndex - 1].seaLevel && activeHours[selectedHourIndex - 1].seaLevel.sg != null ? activeHours[selectedHourIndex - 1].seaLevel.sg : cur)
        : cur;
      const next = selectedHourIndex < activeHours.length - 1
        ? (activeHours[selectedHourIndex + 1] && activeHours[selectedHourIndex + 1].seaLevel && activeHours[selectedHourIndex + 1].seaLevel.sg != null ? activeHours[selectedHourIndex + 1].seaLevel.sg : cur)
        : cur;
      const tideState = getTideState(prev, cur, next);

      const currentDate = getForecastBaseDate(0);
      const hasLiveWind = !!(hr.windGust && hr.windGust.sg != null && hr.windDirection && hr.windDirection.sg != null);
      const activeWind = hasLiveWind && isActiveWind(hr);
      document.getElementById('dateLine').textContent = formatDateArabic(currentDate) + ' • ' + selectedStation.name;
      if (!hasEnvDto) {
        document.getElementById('moonIcon').textContent = moon.icon;
        document.getElementById('moonVal').textContent = moon.label;
      }
      const fdi = computeFDI(date);
      const _fdiLabel = fdi >= 70 ? 'نشاط عالٍ' : fdi >= 45 ? 'نشاط متوسط' : 'نشاط منخفض';
      document.getElementById('currentWaterHeight').innerHTML = 'اتجاه الماء: <span class="tide-dir-badge ' + tideState.cls + '">' + tideState.arrow + ' ' + tideState.label + '</span> — الارتفاع: ' + (sea != null ? sea.toFixed(2) + ' م' : 'غير معروف') + ' — ' + _fdiLabel;

      const dorahLabel = (dar.darName.split(' - ')[1] || dar.darName);
      document.getElementById('dorahName').textContent = 'ذروة الدر: ' + dorahLabel;
      document.getElementById('durDayInPeriodVal').textContent = String(dar.dayInDar);
      document.getElementById('durElapsedVal').textContent = String(dar.canonicalDarDay);
      document.getElementById('dorahDetail').textContent = 'تقويم الدرة | الموسم: ' + dar.seasonName + ' — اليوم ' + dar.canonicalDarDay;
      document.getElementById('durPeriodRangeVal').textContent = 'نطاق تقليدي (مؤشر) — يوم ' + dar.dayInDar + ' من 10';
      document.getElementById('dorahCountdownLine').textContent = 'باقي ' + dar.daysLeft + ' يوم على ' + dar.nextDarLabel;
      document.getElementById('dorahInfoBox').textContent = getDorahInfoText(dorahLabel);
      document.getElementById('countdownDays').textContent = String(dar.daysLeft) + ' يوم';
      document.getElementById('dorahWarning').textContent = dar.warning;
      const statusEl = document.getElementById('windOfficialStatus');
      if (statusEl) {
        if (!hasLiveWind) {
          statusEl.style.display = 'block';
          statusEl.textContent = 'بيانات الرياح مبسطة من التحليل (بدون نموذج ساعي خارجي).';
        } else if (activeWind) {
          statusEl.style.display = 'block';
          statusEl.textContent = 'رياح نشطة: تم اعتماد الهبة الفعلية بدلاً من المتوسط';
        } else {
          statusEl.style.display = 'none';
        }
      }

      document.getElementById('coastalBtn').classList.toggle('active', activeMode === 'coastal');
      document.getElementById('deepBtn').classList.toggle('active', activeMode === 'deep');

      const manualWarn = document.getElementById('manualOverrideWarning');
      if (manualWarn) {
        manualWarn.style.display = 'none';
        manualWarn.textContent = '';
      }
      updateIntelBlock();
      void nvRefreshSuhailFromTrueFinal();
    }

    function renderNawkhadaBox(_date) {
      updateDailyAdviceFromDto();
    }

    function renderAll() {
      syncSelectedHourSelection();
      const date = getForecastDateByIndex(selectedForecastDay);
      updateAllStationStates(date);
      renderForecastStrip();
      renderNawkhadaBox(date);
      renderHero(date);
      renderTimeline();
      renderCompass(date);
      renderSeaStatusStrip();
      renderFish(date);
      freezePredictionSnapshot();  // Task 4: freeze AFTER rendering — snapshot = what user sees
    }

    async function onStationChange(idx, opts) {
      const options = opts || {};
      const source = options.source === 'map' ? 'map' : 'list';
      currentSharedAnalysisRequest += 1;
      const requestToken = currentSharedAnalysisRequest;
      setAnalysisLoading(true);
      currentPredictionSnapshot = null; // Task 4: invalidate snapshot on station change
      currentSharedAnalysisDto = null;
      selectedStation = navidurEngine.getStationByIndex(idx);
      appTimezone = selectedStation.timezone || 'Asia/Qatar';
      selectionTracking.country = selectedStation.country;
      selectionTracking.region = selectedStation.region || '';
      selectionTracking.station_id = selectedStation.id;
      manualMode = null;
      rebuildDays();
      selectedForecastDay = 0;

      try {
        if (window.NavidurLiveAnalysis && typeof window.NavidurLiveAnalysis.getStationAnalysis === 'function') {
          const dto = await window.NavidurLiveAnalysis.getStationAnalysis(selectedStation, {
            datetime: new Date().toISOString()
          });
          if (requestToken === currentSharedAnalysisRequest) {
            if (dto && typeof dto === 'object') {
              try { delete dto.field_validation; } catch (_e) { /* ignore */ }
            }
            currentSharedAnalysisDto = dto;
          }
        } else {
          currentSharedAnalysisDto = null;
        }
      } catch (_sharedErr) {
        if (requestToken === currentSharedAnalysisRequest) {
          currentSharedAnalysisDto = null;
        }
      }

      const liveBundle = buildStationWeatherFromAnalysis(selectedStation, weekDates, currentSharedAnalysisDto);
      weatherByDay = liveBundle.hoursByDay;
      currentStationLiveMeta = liveBundle.meta;

      selectedHourIndex = getDefaultHourIndex(selectedForecastDay);
      updateAllStationStates(getForecastDateByIndex(selectedForecastDay));
      renderAll();
      if (currentSharedAnalysisDto) {
        renderHotspotPanel(currentSharedAnalysisDto);
      }

      // TASK 1: fire server compute in background (non-blocking, zero regression)
      const _hrForCompute = getActiveHours()[selectedHourIndex] || {};
      serverComputeResult = null;
      tryServerComputeDecision(_hrForCompute, selectedStation.id).catch(function () {});

      syncFlowFromSelectedStation();
      focusStationOnMap(selectedStation);

      try {
        const hotspot = await fetchHotspotForStation(selectedStation);
        latestHotspotResult = hotspot;
        await fetchNavidurWaterLandOverrides();
        renderGridOnMap(hotspot, selectedStation);
        if (!currentSharedAnalysisDto) {
          renderHotspotPanel(hotspot);
          renderHero(getForecastDateByIndex(selectedForecastDay));
        }
        trackOnce('analysis_complete', { event_type: 'analysis_complete', source: source, country: selectionTracking.country || (selectedStation ? selectedStation.country : null), region: selectionTracking.region || (selectedStation ? selectedStation.region : null), station_id: selectedStation ? selectedStation.id : null, station: selectedStation ? selectedStation.name : null, session_id: getSessionId(), timestamp: new Date().toISOString() });
      } catch (_hotspotErr) {
        latestHotspotResult = null;
        const mm = document.getElementById('mapMetaText');
        if (mm && selectedStation) {
          mm.textContent = 'المحطة: ' + selectedStation.name + ' — تعذر رسم نطاق التحليل';
        }
      } finally {
        setAnalysisLoading(false);
      }

      trackOnce('station_select', {
        event_type: 'station_select',
        source: source,
        country: selectionTracking.country || (selectedStation ? selectedStation.country : null),
        region: selectionTracking.region || (selectedStation ? selectedStation.region : null),
        station_id: selectionTracking.station_id || (selectedStation ? selectedStation.id : null),
        station: selectedStation ? selectedStation.name : null,
        lat: selectedStation ? selectedStation.lat : null,
        lon: selectedStation ? selectedStation.lng : null,
        timestamp: new Date().toISOString(),
        session_id: getSessionId()
      });

      if (!options.silentPopup && stationMarkerMap.has(selectedStation.id)) {
        stationMarkerMap.get(selectedStation.id).openPopup();
      }
    }

    async function refreshSelectedStationLiveWind() {
      const idx = selectedStation && typeof selectedStation.index === 'number' ? selectedStation.index : 0;
      await onStationChange(idx);
    }

    async function refreshIfDayChanged(force) {
      const todayKey = getTodayKey();
      if (!force && todayKey === lastKnownAppIsoDay) return;
      if (dayRefreshInFlight) {
        lastKnownAppIsoDay = todayKey;
        return dayRefreshInFlight;
      }
      lastKnownAppIsoDay = todayKey;
      dayRefreshInFlight = refreshAllData().finally(function () {
        dayRefreshInFlight = null;
      });
      return dayRefreshInFlight;
    }

    function setupDayChangeSync() {
      if (dayChangeSyncTimer) {
        clearInterval(dayChangeSyncTimer);
      }
      dayChangeSyncTimer = setInterval(function () {
        refreshIfDayChanged(false);
      }, 60 * 1000);

      document.addEventListener('visibilitychange', function () {
        if (!document.hidden) refreshIfDayChanged(false);
      });

      const interactionRefresh = function () {
        refreshIfDayChanged(false);
      };
      window.addEventListener('pointerdown', interactionRefresh, { passive: true });
      window.addEventListener('keydown', interactionRefresh);
    }

    function autoSteerMode() {
      return getStationDecisionEngine(getForecastDateByIndex(selectedForecastDay), selectedStation);
    }

    async function initApp() {
      loadMemberAuthState();
      await loadRuntimeUiSettings();
      updateMemberAuthUi('', false);

      // Hard lock: block all public users when platform is in maintenance mode.
      // This runs BEFORE station init, maps, analysis, or any homepage flow.
      const _runtimeMode = String((runtimeUiSettings && runtimeUiSettings.site_mode) || '').toLowerCase();
      const _maintenanceMsg = (runtimeUiSettings && runtimeUiSettings.maintenance_message) || '';
      if (_runtimeMode === 'maintenance' && !canBypassMaintenance()) {
        renderMaintenanceLockScreen(_maintenanceMsg);
        return;
      }

      const stationLoad = await loadRuntimeStations();
      resetEngineWithStations(stationLoad.stations);
      setupStationFlow();
      if (!stationLoad.stations.length) {
        showStationLoadUnavailable(stationLoad.warning);
        return;
      }
      renderStations();
      if (stationLoad.degraded && stationLoad.warning) {
        updateStationFlowHint(stationLoad.warning);
      }
      initStationMap();
      navidurBindCastDirectionControls();
      applyLocationModeUi();
      const locationSeenKey = 'navidur_location_prompt_seen';
      if (!localStorage.getItem(locationSeenKey) && !userGeoState.granted && !userGeoState.promptRequested) {
        localStorage.setItem(locationSeenKey, '1');
        requestUserLocationForSorting();
      }
      startLiveClock();
      lastKnownAppIsoDay = getAppIsoDay(new Date());

      if (windRefreshTimer) {
        clearInterval(windRefreshTimer);
      }
      windRefreshTimer = setInterval(function () {
        refreshSelectedStationLiveWind();
      }, UPDATE_FREQUENCY_MINUTES * 60 * 1000);
      setupDayChangeSync();

      var locationBtn = document.getElementById('locationRequestBtn');
      if (locationBtn) {
        locationBtn.addEventListener('click', function () {
          userGeoState.promptRequested = false;
          requestUserLocationForSorting();
        });
      }

      (function bindOptionalUi() {
        var w = document.getElementById('whyToggleBtn');
        if (w) {
          w.addEventListener('click', function () {
            var box = document.getElementById('whySpotBox');
            if (!box) return;
            var visible = box.classList.contains('is-open');
            box.classList.toggle('is-open', !visible);
          });
        }
        var fy = document.getElementById('feedbackYes');
        if (fy) fy.addEventListener('click', function () { sendFeedbackVote('YES'); });
        var fn = document.getElementById('feedbackNo');
        if (fn) fn.addEventListener('click', function () { sendFeedbackVote('NO'); });
      }());

      document.getElementById('coastalBtn').addEventListener('click', function () {
        const msg = 'هذا المؤشر للعرض فقط ويعكس نوع الصيد من بيانات المحطة المختارة.';
        document.getElementById('manualOverrideWarning').style.display = 'block';
        document.getElementById('manualOverrideWarning').textContent = msg;
      });

      document.getElementById('deepBtn').addEventListener('click', function () {
        const msg = 'هذا المؤشر للعرض فقط ويعكس نوع الصيد من بيانات المحطة المختارة.';
        document.getElementById('manualOverrideWarning').style.display = 'block';
        document.getElementById('manualOverrideWarning').textContent = msg;
      });

      document.getElementById('modalClose').addEventListener('click', closeModal);
      document.getElementById('fishModal').addEventListener('click', function (e) {
        if (e.target.id === 'fishModal') closeModal();
      });

      setInterval(flushTrackingQueue, 15000);
    }

    initApp();
  </script>
