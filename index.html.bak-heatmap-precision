    function toUtcDay(date) {
      const d = new Date(date || new Date());
      return Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate());
    }

    function dayOfYearUtc(year, month, day) {
      const start = Date.UTC(year, 0, 1);
      const target = Date.UTC(year, month - 1, day);
      return Math.floor((target - start) / 86400000) + 1;
    }

    function dateFromDayOfYearUtc(year, dayOfYearFloat) {
      const start = Date.UTC(year, 0, 1);
      const ms = start + ((dayOfYearFloat - 1) * 86400000);
      return new Date(ms);
    }

    function getSohailRisingDate(station, year) {
      const targetYear = typeof year === 'number' ? year : new Date().getUTCFullYear();
      const st = station && station.getSohailRisingUtc
        ? station
        : navidurEngine.getStations().find(function (s) {
          return s.name === station;
        }) || navidurEngine.getStationByIndex(0);
      return st.getSohailRisingUtc(targetYear);
    }

    function getSohailSeasonDate(targetDate, station) {
      const now = new Date(targetDate || new Date());
      const year = now.getUTCFullYear();
      const currentYearSohail = getSohailRisingDate(station, year);
      if (now.getTime() >= currentYearSohail.getTime()) {
        return currentYearSohail;
      }
      return getSohailRisingDate(station, year - 1);
    }

    function normalizeCycleDay(day) {
      return ((day - 1) % 360 + 360) % 360 + 1;
    }

    function getDarahNameByCanonicalDay(canonicalDarDay) {
      const darBlockOffset = Math.round((canonicalDarDay - 220) / 10);
      const len = DORAH_28_ORDER.length;
      const idx = ((darBlockOffset % len) + len) % len;
      return DORAH_28_ORDER[idx];
    }

    function getPopularSeasonByCycleDay(cycleDay) {
      const blockSize = 36;
      const idx = Math.floor((normalizeCycleDay(cycleDay) - 1) / blockSize) % POPULAR_SEASONS_LAYOUT.length;
      return POPULAR_SEASONS_LAYOUT[idx];
    }

    // Returns accurate Gulf calendar season based on current date via DURUR_MAPPING.
    function getSeasonNameByDate(date) {
      const d = new Date(date || new Date());
      const p = getAppDateParts(d);
      const monthCode = getMonthCode(p.month);
      for (var season in DURUR_MAPPING) {
        if (DURUR_MAPPING[season].includes(monthCode)) return season;
      }
      return 'غير محدد';
    }

    function getCurrentDar(date, stationOverride) {
      const now = new Date(date || new Date());
      const station = stationOverride || selectedStation || navidurEngine.getStationByIndex(0);
      const sohailSeasonDate = getSohailSeasonDate(now, station);
      const diffSecondsSinceSohail = Math.floor((now.getTime() - sohailSeasonDate.getTime()) / 1000);
      const diffDaysSinceSohail = Math.floor(diffSecondsSinceSohail / 86400);
      const alignedDayInCycle = normalizeCycleDay(diffDaysSinceSohail - PERPETUAL_PHASE_SHIFT_DAYS + 1);
      const dayIndex = (alignedDayInCycle - 1) % 10;
      const dayInDar = dayIndex + 1;
      const darIndex = Math.floor((alignedDayInCycle - 1) / 10);
      const darValue = (darIndex + 1) * 10;
      const nextDar = darValue === 360 ? 10 : darValue + 10;

      const canonicalDayInCycle = normalizeCycleDay(alignedDayInCycle + CANONICAL_DORAH_DAY_SHIFT);
      const canonicalDarDay = (Math.floor((canonicalDayInCycle - 1) / 10) + 1) * 10;
      const nextCanonicalDarDay = canonicalDarDay === 360 ? 10 : canonicalDarDay + 10;
      const seasonName = getSeasonNameByDate(now);

      const darTraditionalName = getDarahNameByCanonicalDay(canonicalDarDay);
      const nextDarTraditionalName = getDarahNameByCanonicalDay(nextCanonicalDarDay);
      const daysLeft = 10 - dayIndex;

      return {
        dar: darValue,
        darName: 'در الـ ' + darValue + ' - ' + darTraditionalName,
        nextDarLabel: 'در الـ ' + nextDar + ' - ' + nextDarTraditionalName,
        canonicalDarDay,
        seasonName,
        dayInDar,
        daysLeft,
        warning: 'تنبيه: ثبّت قرارك على حركة الماء واتجاه الريح قبل النزول.'
      };
    }

    function getLunarDay(date) {
      try {
        const d = new Date(date || new Date());
        const parts = new Intl.DateTimeFormat('en-u-ca-islamic-umalqura', {
          day: 'numeric', timeZone: appTimezone
        }).formatToParts(d);
        const dayPart = parts.find(function (p) { return p.type === 'day'; });
        const parsed = parseInt(dayPart && dayPart.value ? dayPart.value : '0', 10);
        if (parsed >= 1 && parsed <= 30) return parsed;
      } catch (e) {}
      return 16;
    }

    function getMoonPhase(date) {
      const lunarDay = getLunarDay(date);
      if (lunarDay === 15) return { icon:'🌕', label:'بدر' };
      if (lunarDay >= 12 && lunarDay <= 17) return { icon:'🌔', label:'أحدب متزايد' };
      if (lunarDay >= 8 && lunarDay <= 11) return { icon:'🌓', label:'تربيع أول' };
      if (lunarDay >= 4 && lunarDay <= 7) return { icon:'🌒', label:'هلال متزايد' };
      if (lunarDay >= 1 && lunarDay <= 3) return { icon:'🌙', label:'هلال' };
      if (lunarDay >= 23 && lunarDay <= 27) return { icon:'🌘', label:'هلال متناقص' };
      if (lunarDay >= 18 && lunarDay <= 22) return { icon:'🌖', label:'أحدب متناقص' };
      return { icon:'🌑', label:'محاق' };
    }

    function getHamalFasadStatus(date) {
      const lunarDay = getLunarDay(date);
      const hamal = (lunarDay >= 1 && lunarDay <= 7) || (lunarDay >= 15 && lunarDay <= 22);
      return { name: hamal ? 'حمل' : 'فساد', lunarDay };
    }

    function getDailyFishingLabel(date, station) {
      const decision = getStationDecisionEngine(date, station, 0);
      return {
        text: decision.mode === 'deep' ? 'غزير' : 'ساحلي',
        mode: decision.mode
      };
    }

    function startLiveClock() {
      function tick() {
        const now = new Date();
        const time = new Intl.DateTimeFormat('ar-QA', {
          hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false, timeZone: appTimezone
        }).format(now);
        const el = document.getElementById('liveClock');
        if (el) el.textContent = 'الوقت الآن: ' + time;
      }
      tick();
      setInterval(tick, 1000);
    }

    function getDorahInfoText(dorahName) {
      return DORAH_INFO[dorahName] || 'معلومات الدر: فترة انتقال موسمية، راقب اتجاه الماية واختر موقع الصيد حسب الحالة.';
    }

    function getTagClass(tag) {
      if (!tag) return '';
      if (tag.includes('وفير')) return 'tag-wafir';
      if (tag.includes('تكاثر')) return 'tag-takathur';
      if (tag.includes('موسمي')) return 'tag-mawsami';
      return '';
    }

    function getTideState(prev, cur, next) {
      if (prev == null || cur == null || next == null) {
        return { key: 'steady', label: 'ثابت', arrow: '●', cls: 'tide-turn' };
      }

      const trend = next - prev;
      const threshold = 0.04;

      if (trend > threshold) {
        return { key: 'sagi', label: 'سقي', arrow: '↑', cls: 'tide-up' };
      }
      if (trend < -threshold) {
        return { key: 'thabr', label: 'ثبر', arrow: '↓', cls: 'tide-down' };
      }
      return { key: 'steady', label: 'ثابت', arrow: '●', cls: 'tide-turn' };
    }

    function windDirText8(deg) {
      const d = ['شمال','شمال شرقي','شرق','جنوب شرقي','جنوب','جنوب غربي','غرب','شمال غربي'];
      return d[Math.round((((deg % 360) + 360) % 360) / 45) % 8];
    }

    function mpsToKmh(v) { return typeof v === 'number' ? +(v * 3.6).toFixed(1) : null; }

    function getDisplayedWindKmh(hourData) {
      const gustMs = hourData && hourData.windGust && hourData.windGust.sg != null ? hourData.windGust.sg : null;
      const speedMs = hourData && hourData.windSpeed && hourData.windSpeed.sg != null ? hourData.windSpeed.sg : null;
      const gustKmh = mpsToKmh(gustMs);
      const speedKmh = mpsToKmh(speedMs);
      if (gustKmh == null) return null;
      const isFluctuating = speedKmh != null && Math.abs(gustKmh - speedKmh) >= 8;
      return isFluctuating && gustKmh < 10 ? 10 : gustKmh;
    }

    function isActiveWind(hourData) {
      const gustMs = hourData && hourData.windGust && hourData.windGust.sg != null ? hourData.windGust.sg : null;
      const speedMs = hourData && hourData.windSpeed && hourData.windSpeed.sg != null ? hourData.windSpeed.sg : null;
      const gustKmh = mpsToKmh(gustMs);
      const speedKmh = mpsToKmh(speedMs);
      if (gustKmh == null || speedKmh == null) return false;
      return Math.abs(gustKmh - speedKmh) >= 8;
    }

    function formatHourArabic(dateValue) {
      const p = getAppDateParts(new Date(dateValue));
      const suffix = p.hour >= 12 ? 'م' : 'ص';
      const hr12 = ((p.hour + 11) % 12) + 1;
      return hr12 + ' ' + suffix;
    }

    function trendLabel(prev, cur, next) {
      if (prev == null || cur == null || next == null) return 'ثابت';
      const diff = next - prev;
      if (diff > 0.06) return 'سقي';
      if (diff < -0.06) return 'ثبر';
      return 'ثابت';
    }

    function toIsoDay(date) {
      const d = new Date(date || Date.now());
      return d.toISOString().slice(0, 10);
    }

    function buildStationWeatherFromAnalysis(station, targetWeekDates, dto) {
      if (!window.NavidurLiveAnalysis || typeof window.NavidurLiveAnalysis.buildWeatherByDayFromDto !== 'function') {
        return {
          hoursByDay: (targetWeekDates || []).map(function () { return []; }),
          meta: { source: 'navidur_analysis_dto', isLive: false, error: 'navidur_live_script_missing' }
        };
      }
      const out = window.NavidurLiveAnalysis.buildWeatherByDayFromDto(dto, targetWeekDates, getAppIsoDay);
      return {
        hoursByDay: out.hoursByDay,
        meta: Object.assign({}, out.meta, {
          stationId: station && station.id,
          stationName: station && station.name,
          tideSource: station && station.tideSource
        })
      };
    }

    function getActiveHours() {
      return weatherByDay[selectedForecastDay] || [];
    }

    function getSafeHourIndex(dayIndex, hourIndex) {
      const hours = weatherByDay[dayIndex] || [];
      if (!hours.length) return 0;
      const baseIndex = typeof hourIndex === 'number' ? hourIndex : 0;
      return Math.max(0, Math.min(baseIndex, hours.length - 1));
    }

    function syncSelectedHourSelection() {
      const maxDayIndex = Math.max(0, weatherByDay.length - 1);
      selectedForecastDay = Math.max(0, Math.min(selectedForecastDay, maxDayIndex));
      selectedHourIndex = getSafeHourIndex(selectedForecastDay, selectedHourIndex);
    }

    function getSelectedHourEntry() {
      syncSelectedHourSelection();
      const hours = getActiveHours();
      return {
        dayIndex: selectedForecastDay,
        hourIndex: selectedHourIndex,
        hour: hours[selectedHourIndex] || {}
      };
    }

    function getTimelineEntries(count) {
      syncSelectedHourSelection();
      const entries = [];
      for (let dayIdx = selectedForecastDay; dayIdx < weatherByDay.length && entries.length < count; dayIdx++) {
        const dayHours = weatherByDay[dayIdx] || [];
        if (!dayHours.length) continue;
        const startAt = dayIdx === selectedForecastDay ? getSafeHourIndex(dayIdx, selectedHourIndex) : 0;
        for (let hourIdx = startAt; hourIdx < dayHours.length && entries.length < count; hourIdx++) {
          entries.push({ dayIndex: dayIdx, hourIndex: hourIdx, hour: dayHours[hourIdx] || {} });
        }
      }
      return entries;
    }

    function getDefaultHourIndex(dayIndex) {
      const hours = weatherByDay[dayIndex] || [];
      if (!hours.length) return 0;
      const forecastDate = getForecastDateByIndex(dayIndex);
      const todayKey = getAppIsoDay(new Date());
      const isToday = forecastDate && getAppIsoDay(forecastDate) === todayKey;
      const targetHour = isToday ? getAppDateParts(new Date()).hour : 0;
      return Math.max(0, Math.min(targetHour, hours.length - 1));
    }

    function getCurrentTideMetrics() {
      const decision = getStationDecisionEngine(getForecastDateByIndex(selectedForecastDay), selectedStation);
      return {
        tideState: decision.tideState,
        amplitude: decision.amplitude,
        tidalCoefficient: decision.tidalCoefficient,
        waterState: decision.waterState,
        migrationSeason: decision.migrationSeason,
        migrationAdvice: decision.migrationAdvice
      };
    }

    function getTidalCoefficient(tideState, prev, cur, next) {
      if (prev == null || cur == null || next == null) return 0;
      const amplitudeCm = Math.abs(next - prev) * 100;
      const acceleration = (Math.abs(cur - prev) + Math.abs(next - cur)) * 100;
      const trendBoost = tideState.key === 'sagi' ? 16 : tideState.key === 'thabr' ? 10 : 0;
      const coefficient = Math.round((amplitudeCm * 1.25) + (acceleration * 0.8) + trendBoost);
      return Math.max(0, Math.min(100, coefficient));
    }

    function getWaterStateFromCoefficient(coef) {
      return coef >= 55 ? 'حمل' : 'فساد';
    }

    function getCurrentMigrationSeason(date, station) {
      const dar = getCurrentDar(date, station);
      return dar && dar.seasonName ? dar.seasonName : 'غير محدد';
    }

    function getMigrationAdviceByState(waterState, mode, seasonName) {
      if (waterState === 'حمل') {
        return 'موسم ' + seasonName + ': السمك الآن يرعى في القوع بسبب قوة الحمل، وتفعيل الغزير هو الأنسب لهذه الساعة.';
      }
      return 'موسم ' + seasonName + ': الماية فساد الآن، والسمك يقترب من الساحل، لذلك تفعيل الساحلي هو الأنسب لهذه الساعة.';
    }

    function getStationDecisionEngine(date, station, hourIndexOverride) {
      const st = station || selectedStation || navidurEngine.getStationByIndex(0);
      const iso = toIsoDay(date);
      const dayIdx = weekDates.findIndex(function (d) { return toIsoDay(d) === iso; });
      const hours = dayIdx >= 0 ? (weatherByDay[dayIdx] || []) : [];
      const baseIndex = typeof hourIndexOverride === 'number'
        ? hourIndexOverride
        : (dayIdx === selectedForecastDay ? selectedHourIndex : 0);
      const idx = Math.max(0, Math.min(baseIndex, Math.max(0, hours.length - 1)));
      const curHour = hours[idx] || {};
      const cur = curHour.seaLevel && curHour.seaLevel.sg != null ? curHour.seaLevel.sg : null;
      const prev = idx > 0
        ? (hours[idx - 1] && hours[idx - 1].seaLevel && hours[idx - 1].seaLevel.sg != null ? hours[idx - 1].seaLevel.sg : cur)
        : cur;
      const next = idx < hours.length - 1
        ? (hours[idx + 1] && hours[idx + 1].seaLevel && hours[idx + 1].seaLevel.sg != null ? hours[idx + 1].seaLevel.sg : cur)
        : cur;
      const tideState = getTideState(prev, cur, next);
      const amplitude = prev == null || next == null ? 0 : Math.abs(next - prev);

      // Strict real-data mode: do not infer tide/water state locally when live data is missing.
      if (cur == null || prev == null || next == null) {
        return {
          status: 'INSUFFICIENT_DATA',
          mode: null,
          waterState: null,
          tidalCoefficient: null,
          tideState: tideState,
          amplitude: amplitude,
          migrationSeason: null,
          migrationAdvice: null
        };
      }

      const tidalCoefficient = getTidalCoefficient(tideState, prev, cur, next);
      const waterState = getWaterStateFromCoefficient(tidalCoefficient);
      const mode = waterState === 'حمل' ? 'deep' : 'coastal';
      const migrationSeason = getCurrentMigrationSeason(date, st);
      return {
        mode: mode,
        waterState: waterState,
        tidalCoefficient: tidalCoefficient,
        tideState: tideState,
        amplitude: amplitude,
        migrationSeason: migrationSeason,
        migrationAdvice: getMigrationAdviceByState(waterState, mode, migrationSeason)
      };
    }

    function getAutomaticModeFromLiveData(date, station) {
      return getStationDecisionEngine(date, station).mode;
    }

    function computeFDI(date) {
      const hr = getActiveHours()[selectedHourIndex] || {};
      const ws = mpsToKmh(hr.windSpeed && hr.windSpeed.sg != null ? hr.windSpeed.sg : 0) || 0;
      const tide = getCurrentTideMetrics();
      const mode = getAutomaticModeFromLiveData(date, selectedStation);
      const isSagiStrong = tide.tideState.key === 'sagi' && tide.amplitude >= 0.12;

      let score = 42;
      score += ws > 26 ? 22 : ws > 18 ? 12 : 4;
      score += tide.amplitude > 0.2 ? 18 : tide.amplitude > 0.12 ? 10 : 4;
      if (selectedStation.bathymetry === 'deep') score += 6;
      if (selectedStation.bathymetry === 'shallow') score -= 4;
      if (mode === 'deep' && isSagiStrong) score -= 14;

      return Math.max(0, Math.min(100, Math.round(score)));
    }

    function getActiveMode(date) {
      return getSelectedStationMode();
    }

    // ── TASK 1: server-side compute layer (async, non-blocking) ──────────────
    // Fires POST /api/compute-decision and stores result in serverComputeResult.
    // Client local logic runs first; this call happens in background.
    // If it fails or times out the local result is already displayed — zero regression.
    async function tryServerComputeDecision(hourData, stationId) {
      try {
        const hr = hourData || {};
        const activeHours = getActiveHours();
        const idx = selectedHourIndex;
        const cur = hr.seaLevel && hr.seaLevel.sg != null ? hr.seaLevel.sg : null;
        const prev = idx > 0
          ? (activeHours[idx - 1] && activeHours[idx - 1].seaLevel && activeHours[idx - 1].seaLevel.sg != null ? activeHours[idx - 1].seaLevel.sg : cur)
          : cur;
        const next = idx < activeHours.length - 1
          ? (activeHours[idx + 1] && activeHours[idx + 1].seaLevel && activeHours[idx + 1].seaLevel.sg != null ? activeHours[idx + 1].seaLevel.sg : cur)
          : cur;
        const windSpeedKmh = hr.windSpeed && hr.windSpeed.sg != null
          ? (hr.windSpeed.sg * 3.6)
          : null;

        const controller = typeof AbortController !== 'undefined' ? new AbortController() : null;
        const timeoutId = controller
          ? setTimeout(function () { controller.abort(); }, 5000)
          : null;

        const payload = {
          station_id: stationId || (selectedStation && selectedStation.id) || '',
          lat: selectedStation ? selectedStation.lat : 0,
          lng: selectedStation ? selectedStation.lng : 0,
          wind: { speed: windSpeedKmh, direction: hr.windDirection && hr.windDirection.sg != null ? hr.windDirection.sg : null },
          tide: { current: cur, previous: prev, next: next },
          temperature: hr.waterTemperature && hr.waterTemperature.sg != null ? hr.waterTemperature.sg : null
        };

        const fetchOpts = { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) };
        if (controller) fetchOpts.signal = controller.signal;

        const resp = await fetch('/api?route=compute-decision', fetchOpts);
        if (timeoutId) clearTimeout(timeoutId);

        if (resp.ok) {
          const result = await resp.json();
          serverComputeResult = Object.assign({}, result, { _fetchedAt: Date.now(), _stationId: stationId });
          // ── Task 7: update prediction snapshot with server compute result ──
          if (currentPredictionSnapshot && currentPredictionSnapshot.station_id === stationId) {
            currentPredictionSnapshot.compute_source = 'server';
            currentPredictionSnapshot.server_water_state = result.waterState;
            currentPredictionSnapshot.server_tidal_coefficient = result.tidalCoefficient;
            currentPredictionSnapshot.server_activity_score = result.activityScore;
          }
        }
      } catch (_err) {
        // Silently fall back to local computation — no user impact
      }
    }
    // ── end TASK 1 ──────────────────────────────────────────────────────────

    // ── TASK 4: freeze prediction snapshot ───────────────────────────────────
    // Called from renderAll() AFTER all rendering is complete.
    // Captures exactly what the user sees at analysis time.
    // Once frozen, it is never recomputed — only server compute fields are appended later.
    function freezePredictionSnapshot() {
      if (!selectedStation || !selectedStation.id) {
        currentPredictionSnapshot = null;
        return;
      }
      if (currentSharedAnalysisDto) {
        currentPredictionSnapshot = {
          snapshot_id: 'snap_' + Date.now().toString(36) + Math.random().toString(36).slice(2, 7),
          station_id: selectedStation.id,
          station_name: selectedStation.name || '',
          lat: selectedStation.lat != null ? selectedStation.lat : null,
          lng: selectedStation.lng != null ? selectedStation.lng : null,
          analysis_timestamp: currentSharedAnalysisDto.analysis_timestamp,
          tide_current: currentSharedAnalysisDto.tide.current_speed_ms,
          tide_previous: null,
          tide_next: null,
          wind_speed_kmh: currentSharedAnalysisDto.environment.wind_speed_kmh,
          wind_direction: currentSharedAnalysisDto.environment.wind_direction_deg,
          temperature: currentSharedAnalysisDto.environment.temp_c,
          tidal_coefficient: currentSharedAnalysisDto.fishing.confidence_score,
          water_state: getSharedWaterStateArabic(),
          activity_score: currentSharedAnalysisDto.fishing.confidence_score,
          fishing_mode: getSharedFishingMode(),
          species_predicted: getSharedSpeciesNames(),
          compute_source: 'shared_engine',
          server_water_state: null,
          server_tidal_coefficient: null,
          server_activity_score: null
        };
        return;
      }
      const date = getForecastDateByIndex(selectedForecastDay);
      const activeHours = getActiveHours();
      const idx = selectedHourIndex;
      const hr = activeHours[idx] || {};
      const cur = hr.seaLevel && hr.seaLevel.sg != null ? hr.seaLevel.sg : null;
      const prev = idx > 0
        ? (activeHours[idx - 1] && activeHours[idx - 1].seaLevel && activeHours[idx - 1].seaLevel.sg != null ? activeHours[idx - 1].seaLevel.sg : cur)
        : cur;
      const next = idx < activeHours.length - 1
        ? (activeHours[idx + 1] && activeHours[idx + 1].seaLevel && activeHours[idx + 1].seaLevel.sg != null ? activeHours[idx + 1].seaLevel.sg : cur)
        : cur;

      const _stState = stationStates && selectedStation ? stationStates[selectedStation.id] : null;
      const waterState = _stState && _stState.waterState ? _stState.waterState : null;
      const tidalCoeff = _stState && typeof _stState.tidalCoefficient === 'number' ? _stState.tidalCoefficient : null;
      const fishingMode = _stState && _stState.mode ? _stState.mode : getActiveMode(date);
      const fdi = computeFDI(date);
      const topFish = getFishForStation(date, waterState).slice(0, 5).map(function (f) { return f.name_ar; });

      // Generate stable snapshot id for this analysis view
      const snapId = 'snap_' + Date.now().toString(36) + Math.random().toString(36).slice(2, 7);

      currentPredictionSnapshot = {
        snapshot_id: snapId,
        station_id: selectedStation.id,
        station_name: selectedStation.name || '',
        lat: selectedStation.lat != null ? selectedStation.lat : null,
        lng: selectedStation.lng != null ? selectedStation.lng : null,
        analysis_timestamp: new Date().toISOString(),
        // Environment frozen at this exact selected hour
        tide_current: cur,
        tide_previous: prev,
        tide_next: next,
        wind_speed_kmh: hr.windSpeed && hr.windSpeed.sg != null ? +(hr.windSpeed.sg * 3.6).toFixed(1) : null,
        wind_direction: hr.windDirection && hr.windDirection.sg != null ? hr.windDirection.sg : null,
        temperature: hr.waterTemperature && hr.waterTemperature.sg != null ? hr.waterTemperature.sg : null,
        // Local predictions
        tidal_coefficient: tidalCoeff,
        water_state: waterState,
        activity_score: fdi,
        fishing_mode: fishingMode,
        species_predicted: topFish,
        // Server compute — populated later by tryServerComputeDecision if it succeeds
        compute_source: 'local',
        server_water_state: null,
        server_tidal_coefficient: null,
        server_activity_score: null
      };
    }
    // ── end TASK 4 ──────────────────────────────────────────────────────────

    function updateAllStationStates(date) {
      const targetDate = new Date(date || new Date());
      const out = {};
      navidurEngine.getStations().forEach(function (st) {
        let sharedWaterState = null;
        if (currentSharedAnalysisDto && selectedStation && st.id === selectedStation.id) {
          sharedWaterState = getSharedWaterStateArabic();
        }
        const binaryWater = (sharedWaterState === 'حمل' || sharedWaterState === 'فساد') ? sharedWaterState : null;
        const decision = st.id === selectedStation.id && !binaryWater
          ? getStationDecisionEngine(targetDate, st)
          : null;
        const mode = st.id === selectedStation.id && binaryWater
          ? (binaryWater === 'حمل' ? 'deep' : 'coastal')
          : (decision ? decision.mode : getDailyFishingLabel(targetDate, st).mode);
        const currentDar = getCurrentDar(targetDate, st);
        out[st.id] = {
          stationId: st.id,
          stationName: st.name,
          tideSource: st.id === selectedStation.id && currentStationLiveMeta && currentStationLiveMeta.source
            ? currentStationLiveMeta.source
            : st.tideSource,
          bathymetry: st.bathymetry,
          mode: mode,
          waterState: sharedWaterState != null ? sharedWaterState : (decision ? decision.waterState : null),
          tidalCoefficient: currentSharedAnalysisDto && selectedStation && st.id === selectedStation.id
            ? (currentSharedAnalysisDto.fishing ? currentSharedAnalysisDto.fishing.confidence_score : null)
            : (decision ? decision.tidalCoefficient : null),
          migrationSeason: decision ? decision.migrationSeason : null,
          migrationAdvice: currentSharedAnalysisDto && selectedStation && st.id === selectedStation.id
            ? currentSharedAnalysisDto.fishing.advice_text
            : (decision ? decision.migrationAdvice : null),
          dorah: currentDar.dar,
          season: currentDar.seasonName
        };
      });
      stationStates = out;
      return out;
    }

    function getSharedTideDisplayArabic() {
      if (!currentSharedAnalysisDto || !currentSharedAnalysisDto.environment) return null;
      const et = currentSharedAnalysisDto.environment.tide;
      if (!et || et.state == null) return null;
      const s = String(et.state).trim();
      if (s === 'سقي' || s === 'ثبر' || s === 'خامل') return s;
      return null;
    }

    /** حكم المحرك للصيد فقط: حمل / فساد / غير واضح — لا يُشتق من اتجاه المد (سقي/ثبر/خامل). */
    function getSharedWaterStateArabic() {
      if (!currentSharedAnalysisDto || !currentSharedAnalysisDto.tide) return null;
      const s = currentSharedAnalysisDto.tide.state;
      if (s === 'LOAD') return 'حمل';
      if (s === 'FASAD') return 'فساد';
      if (s === 'UNKNOWN') return 'غير واضح';
      return null;
    }

    function getSharedFishingWaterLabelAr() {
      const w = getSharedWaterStateArabic();
      if (w) return w;
      if (currentSharedAnalysisDto && currentSharedAnalysisDto.tide) return 'غير واضح';
      return null;
    }

    function getSharedSkyStatusArabic() {
      if (!currentSharedAnalysisDto || !currentSharedAnalysisDto.environment) {
        return 'غير متاح حالياً';
      }
      const w = String(currentSharedAnalysisDto.environment.weather_status_ar != null
        ? currentSharedAnalysisDto.environment.weather_status_ar
        : '').trim();
      return w || 'غير متاح حالياً';
    }

    function nvEscapeHtml(value) {
      return String(value == null ? '' : value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    var nvTrueFinalDoc = null;
    function nvFindTrueFinalStationRow(station, doc) {
      if (!doc || !Array.isArray(doc.stations) || !station) return null;
      const name = String(station.name || '').trim();
      const lat = Number(station.lat);
      const lon = Number(station.lon != null ? station.lon : station.lng);
      let row = doc.stations.find(function (r) {
        return String(r.station_name_ar || '').trim() === name;
      });
      if (row) return row;
      if (Number.isFinite(lat) && Number.isFinite(lon)) {
