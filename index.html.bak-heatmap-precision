    /**
     * Post-processing for map circle colors only. Does not modify point scores or server logic.
     * Downgrades isolated high-score (red) points surrounded by low-scoring neighbors.
     */
    function computeMapPointDisplayVisuals(points) {
      const RED_THRESHOLD = 80;
      const BLUE_NEIGHBOR_AVG_MAX = 58;
      const HIGH_NEIGHBOR_SCORE_MIN = 80;
      const MIN_NEIGHBORS = 2;
      const NEIGHBOR_RADIUS_DEG = 0.018;

      const list = Array.isArray(points) ? points : [];
      const n = list.length;
      const scores = list.map(function (p) { return Number(p && p.score) || 0; });
      const lats = list.map(function (p) { return Number(p && p.lat); });
      const lons = list.map(function (p) { return Number(p && p.lon); });

      const out = [];
      for (let i = 0; i < n; i += 1) {
        const neighScores = [];
        for (let j = 0; j < n; j += 1) {
          if (i === j) continue;
          const dLat = lats[i] - lats[j];
          const dLon = lons[i] - lons[j];
          const dist = Math.sqrt(dLat * dLat + dLon * dLon);
          if (dist > 0 && dist <= NEIGHBOR_RADIUS_DEG) {
            neighScores.push(scores[j]);
          }
        }
        const raw_score = scores[i];
        const rawVisual = getScoreVisual(raw_score);
        let neighbor_avg = neighScores.length
          ? neighScores.reduce(function (a, b) { return a + b; }, 0) / neighScores.length
          : null;
        const high_neighbors_count = neighScores.filter(function (s) { return s >= HIGH_NEIGHBOR_SCORE_MIN; }).length;

        let finalVisual = rawVisual;
        let is_outlier = false;
        if (
          raw_score >= RED_THRESHOLD &&
          neighScores.length >= MIN_NEIGHBORS &&
          neighbor_avg != null &&
          neighbor_avg <= BLUE_NEIGHBOR_AVG_MAX &&
          high_neighbors_count < 2
        ) {
          is_outlier = true;
          finalVisual = neighbor_avg >= 52 ? getScoreVisual(65) : getScoreVisual(45);
        }

        console.debug('NAVIDUR_MAP_POINT_SMOOTHING', {
          point_id: i,
          raw_score: raw_score,
          raw_color: rawVisual.color,
          neighbor_avg: neighbor_avg,
          high_neighbors_count: high_neighbors_count,
          final_color: finalVisual.color,
          is_outlier: is_outlier
        });

        out.push({
          rawVisual: rawVisual,
          finalVisual: finalVisual,
          rawColor: rawVisual.color,
          finalColor: finalVisual.color,
          is_outlier: is_outlier,
          neighbor_avg: neighbor_avg,
          high_neighbors_count: high_neighbors_count
        });
      }
      return out;
    }

    /** Score used only for heatmap/hotspot spatial UI; prefers normalized_score, then raw_score, then score — no recomputation. */
    function navidurPointScoreForHeat(p) {
      if (p == null) return 0;
      if (p.normalized_score != null && !isNaN(Number(p.normalized_score))) return Math.max(0, Math.min(100, Number(p.normalized_score)));
      if (p.raw_score != null && !isNaN(Number(p.raw_score))) return Math.max(0, Math.min(100, Number(p.raw_score)));
      return Math.max(0, Math.min(100, Number(p.score) || 0));
    }

    /**
     * Spatial smoothing for heatmap intensities only (does not alter point scores).
     * Gaussian weights by planar distance in degrees; caps intensity for softer overlay.
     */
    function buildHeatmapSmoothedTriplets(points) {
      const list = Array.isArray(points) ? points : [];
      const n = list.length;
      if (!n) return [];
      const NEIGHBOR_RAD_DEG = 0.014;
      const sigma = NEIGHBOR_RAD_DEG / 2.2;
      const INTENSITY_CAP = 0.58;
      const scores = list.map(function (p) { return navidurPointScoreForHeat(p); });
      const lats = list.map(function (p) { return Number(p && p.lat); });
      const lons = list.map(function (p) { return Number(p && p.lon); });
      const triplets = [];
      for (let i = 0; i < n; i += 1) {
        let wsum = 0;
        let ssum = 0;
        for (let j = 0; j < n; j += 1) {
          const dLat = lats[i] - lats[j];
          const dLon = lons[i] - lons[j];
          const dist = Math.sqrt(dLat * dLat + dLon * dLon);
          if (dist > NEIGHBOR_RAD_DEG) continue;
          const w = dist < 1e-9 ? 1 : Math.exp(-(dist * dist) / (2 * sigma * sigma));
          wsum += w;
          ssum += w * (scores[j] / 100);
        }
        const intensity = wsum > 0 ? Math.min(1, (ssum / wsum) * INTENSITY_CAP) : 0;
        triplets.push([lats[i], lons[i], intensity]);
      }
      return triplets;
    }

    function clusterHighActivityHotspot(points, station) {
      const HIGH_MIN = 72;
      const LINK_M = 480;
      const list = Array.isArray(points) ? points : [];
      const highIdx = [];
      for (let i = 0; i < list.length; i += 1) {
        const s = navidurPointScoreForHeat(list[i]);
        if (s >= HIGH_MIN) highIdx.push(i);
      }
      const minCluster = highIdx.length >= 4 ? 3 : 2;
      const parent = highIdx.map(function (_, k) { return k; });

      function find(k) {
        while (parent[k] !== k) {
          parent[k] = parent[parent[parent[k]]];
          k = parent[k];
        }
        return k;
      }
      function union(a, b) {
        let ra = find(a);
        let rb = find(b);
        if (ra === rb) return;
        if (ra < rb) parent[rb] = ra;
        else parent[ra] = rb;
      }

      for (let a = 0; a < highIdx.length; a += 1) {
        for (let b = a + 1; b < highIdx.length; b += 1) {
          const ia = highIdx[a];
          const ib = highIdx[b];
          const p1 = list[ia];
          const p2 = list[ib];
          const dM = haversineKm(Number(p1.lat), Number(p1.lon), Number(p2.lat), Number(p2.lon)) * 1000;
          if (dM <= LINK_M) union(a, b);
        }
      }

      const groups = {};
      for (let k = 0; k < highIdx.length; k += 1) {
        const r = find(k);
        if (!groups[r]) groups[r] = [];
        groups[r].push(highIdx[k]);
      }

      let clusters = Object.keys(groups).map(function (key) {
        const idxs = groups[key];
        let sum = 0;
        let maxS = 0;
        let clat = 0;
        let clon = 0;
        idxs.forEach(function (ii) {
          const s = navidurPointScoreForHeat(list[ii]);
          sum += s;
          if (s > maxS) maxS = s;
          clat += Number(list[ii].lat);
          clon += Number(list[ii].lon);
        });
        const cnt = idxs.length;
        return {
          point_indices: idxs,
          point_count: cnt,
          avg_score: cnt ? sum / cnt : 0,
          max_score: maxS,
          center_lat: cnt ? clat / cnt : null,
          center_lon: cnt ? clon / cnt : null
        };
      }).filter(function (c) { return c.point_count >= minCluster; });

      clusters.sort(function (a, b) {
        if (b.avg_score !== a.avg_score) return b.avg_score - a.avg_score;
        if (b.max_score !== a.max_score) return b.max_score - a.max_score;
        return b.point_count - a.point_count;
      });

      const best = clusters.length ? clusters[0] : null;
      let direction_from_station = null;
      let distance_from_station_m = null;
      if (best && station && best.center_lat != null && best.center_lon != null) {
        const br = bearingDegFromTo(Number(station.lat), Number(station.lng), best.center_lat, best.center_lon);
        direction_from_station = windDirText8(br);
        distance_from_station_m = haversineKm(Number(station.lat), Number(station.lng), best.center_lat, best.center_lon) * 1000;
      }

      return {
        clusters: clusters,
        best: best,
        minCluster: minCluster,
        highIdx: highIdx,
        direction_from_station: direction_from_station,
        distance_from_station_m: distance_from_station_m
      };
    }

