    function getRegionsForCountry(country) {
      const seen = new Set();
      const regions = [];
      // First: real local regions from station data (filtered — no generic basin names)
      navidurEngine.getStations().forEach(function (st) {
        if (country && st.country !== country) return;
        const r = (st.region || '').trim();
        if (r && !GENERIC_REGION_VALUES.has(r) && !seen.has(r)) {
          seen.add(r);
          regions.push(r);
        }
      });
      // Then: fill in predefined list for anything not already present
      const predefined = PREDEFINED_REGIONS[country] || [];
      predefined.forEach(function (r) {
        if (!seen.has(r)) { seen.add(r); regions.push(r); }
      });
      return regions;
    }

